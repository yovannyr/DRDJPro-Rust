// Interaction vocabulary shared by the Modern presentation components.

export enum DeckAction { load, play-pause, sync, keylock, quantize, loop-toggle, loop-half, loop-double, monitor, fx, edit }
export enum HoldAction { cue, hot-cue, nudge-backward, nudge-forward }
export enum ControlKind { gain, high, mid, low, filter, volume, pitch, crossfader }

export enum JogPhase { begin, move, end, cancel }
