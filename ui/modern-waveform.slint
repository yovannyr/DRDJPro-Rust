import { ModernTheme } from "modern-theme.slint";
import { BeatLine, HotCueRow } from "theme.slint";

export component ModernOverviewStrip inherits Rectangle {
    in property <string> deck-label;
    in property <bool> enabled: false;
    in property <brush> accent;
    in property <[float]> peaks;
    in property <[color]> colors;
    in property <[BeatLine]> beats;
    in property <[HotCueRow]> cues;
    in property <float> playhead: 0.5;
    in property <[float]> markers;
    in property <float> loop-start: -1;
    in property <float> loop-end: -1;
    callback seek(float);
    border-width: 1px; border-color: ModernTheme.line;
    background: ModernTheme.surface; clip: true;
    height: 36px;

    for value[i] in peaks : Rectangle {
        x: i * parent.width / max(1, peaks.length);
        y: (parent.height - self.height) / 2;
        width: max(1px, parent.width / max(1, peaks.length) - 1px);
        height: clamp(value, 0, 1) * max(0px, parent.height - 6px);
        background: i < colors.length ? colors[i] : accent;
    }

    for beat[i] in beats : Rectangle {
        visible: beat.downbeat || beat.warp-marker;
        x: clamp(beat.position, 0, 100) / 100 * max(0px, parent.width - 1px);
        width: 1px; height: parent.height;
        background: beat.first ? #ff4444 : (beat.warp-marker ? #ffae58 : #ffffff70);
    }

    for cue[i] in cues : Rectangle {
        visible: cue.valid;
        x: clamp(cue.position, 0, 100) / 100 * max(0px, parent.width - self.width);
        width: 2px; height: parent.height; background: cue.tint;
    }

    Rectangle {
        visible: root.loop-start >= 0 && root.loop-end >= 0;
        x: clamp(root.loop-start, 0, 100) / 100 * max(0px, parent.width - self.width);
        width: max(0px, (clamp(root.loop-end, 0, 100) - clamp(root.loop-start, 0, 100)) / 100 * parent.width);
        height: parent.height; background: #36dfa322;
    }

    Rectangle {
        x: clamp(root.playhead, 0, 1) * max(0px, parent.width - 2px);
        width: 2px; height: parent.height;
        background: #ffffff;
    }

    Text {
        x: 4px; y: 1px; text: root.deck-label;
        color: ModernTheme.muted; font-size: 9px;
    }

    TouchArea {
        enabled: root.enabled;
        accessible-role: slider;
        accessible-label: root.deck-label + " overview waveform";
        clicked => { if self.width > 0px { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
    }
}

export component ModernDetailWaveform inherits Rectangle {
    in property <string> deck-label;
    in property <string> accessible-deck-label: root.deck-label;
    in property <brush> accent;
    in property <[float]> detail;
    in property <[color]> colors;
    in property <[BeatLine]> beats;
    in property <[HotCueRow]> cues;
    in property <float> playhead: 0.5;
    in property <float> loop-start: -1;
    in property <float> loop-end: -1;
    in property <bool> enabled: false;
    in property <float> detail-start: 0;
    in property <float> detail-end: 100;
    callback seek(float);
    callback zoom();
    in property <bool> keyboard-zoom: false;
    callback zoom-step(int);
    forward-focus: zoom-keys;
    background: ModernTheme.background; clip: true;
    horizontal-stretch: 1;

    property <float> zoom-level: 8;

    function cue-label-x(position: float, column: int) -> length {
        let marker-x = clamp((position - root.detail-start) / max(0.000001, root.detail-end - root.detail-start), 0, 1) * max(0px, root.width - 2px);
        let preferred-x = marker-x + 3px + column * 56px;
        let flipped-x = marker-x - 3px - (column + 1) * 56px;
        let label-x = marker-x > root.width - 115px ? flipped-x : preferred-x;
        return clamp(label-x, 0px, max(0px, root.width - 54px));
    }

    for value[i] in detail : Rectangle {
        x: i * parent.width / max(1, detail.length);
        y: (parent.height - self.height) / 2;
        width: parent.width / max(1, detail.length);
        height: clamp(value, 0, 1) * max(0px, parent.height - 8px);
        background: i < colors.length ? colors[i] : accent;
    }

    for beat[i] in beats : Rectangle {
        x: clamp(beat.position, 0, 100) / 100 * max(0px, parent.width - self.width);
        width: beat.warp-marker || beat.downbeat ? 2px : 1px; height: parent.height;
        background: beat.first ? #ff4444 : (beat.warp-marker ? #ffae58 : (beat.downbeat ? #ffffff99 : #ffffff40));
    }

    for line in beats : Text {
        visible: line.downbeat; x: clamp(line.position,0,100)/100*max(0px,parent.width - 14px); y: 1px;
        text: "" + line.bar; color: line.first ? #ff5555 : ModernTheme.text; font-size: 10px;
        accessible-role: text; accessible-label: root.accessible-deck-label + " bar label"; accessible-description: "Bar " + line.bar;
    }

    for cue[i] in cues : Rectangle {
        visible: cue.valid && cue.position >= root.detail-start && cue.position <= root.detail-end;
        x: (cue.position - root.detail-start) / max(0.000001, root.detail-end - root.detail-start) * max(0px, parent.width - self.width);
        width: 2px; height: parent.height; background: cue.tint;
    }

    for cue[i] in cues : Text {
        visible: cue.valid && cue.position >= root.detail-start && cue.position <= root.detail-end;
        x: root.cue-label-x(cue.position, cue.label-column); y: cue.label-row * 10px;
        width: 54px; height: 10px; text: "" + (i + 1) + " " + cue.name;
        color: cue.tint; font-size: 10px; overflow: elide;
        accessible-role: text;
        accessible-label: root.accessible-deck-label + " detail cue label " + (i + 1);
        accessible-description: cue.description;
    }

    Rectangle {
        visible: root.loop-start >= 0 && root.loop-end >= 0;
        x: clamp(root.loop-start, 0, 100) / 100 * max(0px, parent.width);
        width: max(0px, (clamp(root.loop-end, 0, 100) - clamp(root.loop-start, 0, 100)) / 100 * parent.width);
        height: parent.height; background: #36dfa322;
    }

    Rectangle {
        x: clamp(root.playhead, 0, 1) * max(0px, parent.width - 2px);
        width: 2px; height: parent.height;
        background: #ffffff;
    }

    zoom-keys := FocusScope {
        width: 0;
        enabled: root.enabled && root.keyboard-zoom;
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == "+" {
                root.zoom-step(-1);
                return accept;
            }
            if event.text == "-" {
                root.zoom-step(1);
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        pointer-event(event) => {
            if root.enabled && root.keyboard-zoom && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                zoom-keys.focus();
            }
        }
        enabled: root.enabled;
        accessible-role: slider;
        accessible-label: root.accessible-deck-label + " detail waveform";
        accessible-description: root.keyboard-zoom ? "Click to seek and focus; use + or - while focused to zoom this deck from 2 to 32 source seconds." : "Click to seek within the track.";
        accessible-enabled: self.enabled;
        accessible-value: root.detail-start + root.playhead * (root.detail-end - root.detail-start);
        accessible-value-minimum: root.detail-start;
        accessible-value-maximum: root.detail-end;
        accessible-action-set-value(v) => { if self.enabled && v.is-float() { root.seek(clamp(v.to-float(), root.detail-start, root.detail-end)); } }
        clicked => { if self.width > 0px { root.seek(root.detail-start + clamp(self.mouse-x / self.width, 0, 1) * (root.detail-end - root.detail-start)); } }
    }
}

