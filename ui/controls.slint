// Generated with the full local GUI input; input handlers are retained.
import { Button, Slider, SpinBox, LineEdit, ListView, ComboBox, CheckBox } from "std-widgets.slint";
import { DjTheme, DeckSlotData, LoopRange, SavedLoopRow, HotCueRow, CrateRow, BeatLine, LibraryRow, TableColumn, DeckView, SamplerRow } from "theme.slint";

export component VirtualPlatter inherits Rectangle {
    in property <length> diameter: 120px;
    in property <bool> metadata-known: true;
    in property <string> deck-label;
    in property <string> bpm;
    in property <string> time;
    in property <float> pitch;
    in property <float> position;
    in property <bool> playing;
    in property <float> angle;
    in property <bool> touched;
    in property <bool> scratch-enabled;
    in property <bool> mouse-owned;
    callback scratch-pointer(int, float, float);
    property <bool> dragging;
    function release-pointer() {
        if root.dragging { root.dragging = false; root.scratch-pointer(2, 0, 0); }
    }
    changed scratch-enabled => { if !root.scratch-enabled { root.release-pointer(); } }
    in property <brush> accent;
    width: root.diameter; height: root.diameter;
    border-radius: root.diameter / 2;
    background: #07090c;
    border-width: 5px;
    border-color: root.accent;
    accessible-role: image;
    in property <bool> virtual-mode: true;
    accessible-label: root.deck-label + (root.virtual-mode ? " round virtual platter" : " training platter");
    accessible-description: !root.metadata-known ? "No track data. Transport and scratch unavailable." : root.bpm + " BPM, pitch " + round(root.pitch * 100) / 100 + "%, " + root.time + ", " + round(root.position) + "%, " + (root.touched ? "Jog touched" : root.playing ? "Playing" : "Paused") + ", rotation " + round(root.angle) + " degrees." + (root.scratch-enabled ? " Hold left mouse button and drag around the platter to scratch." : " Scratch unavailable.");
    Rectangle {
        x: (root.width / 2 - 2px) + (root.width / 2 - 6px) * sin(root.angle * 1deg); y: (root.height / 2 - 2px) - (root.height / 2 - 6px) * cos(root.angle * 1deg);
        width: 4px; height: 4px; border-radius: 2px; background: root.touched ? #ffffff : #ffce77;
    }
    Rectangle {
        x: 9px; y: 9px; width: parent.width - 18px; height: parent.height - 18px;
        border-radius: self.width / 2; background: #f4f4f2;
        VerticalLayout {
            padding-left: 9px; padding-right: 9px; padding-top: 3px; padding-bottom: 3px; spacing: 0px;
            Text { text: root.bpm; font-size: root.diameter < 100px ? 14px : 20px; font-weight: 800; color: #141414; horizontal-alignment: center; }
            Text { text: "BPM"; font-size: 9px; color: #343434; horizontal-alignment: center; }
            Text { text: root.metadata-known ? (root.pitch > 0 ? "+" : "") + round(root.pitch * 100) / 100 + "%" : "—"; font-size: 11px; color: #141414; horizontal-alignment: center; }
            Text { text: root.time; font-size: root.diameter < 100px ? 9px : 12px; font-weight: 700; color: #141414; horizontal-alignment: center; }
            Text { text: root.metadata-known ? round(root.position) + "%" : "—"; font-size: 9px; color: #343434; horizontal-alignment: center; }
        }
    }
    touch := TouchArea {
        enabled: root.scratch-enabled;
        mouse-cursor: root.dragging && root.mouse-owned && root.touched ? none : grab;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                if !root.dragging {
                    keys.focus();
                    root.dragging = true;
                    root.scratch-pointer(0, (self.mouse-x - root.width / 2) / 1px, (self.mouse-y - root.height / 2) / 1px);
                }
            } else if event.kind == PointerEventKind.cancel || event.kind == PointerEventKind.up {
                // Slint releases pointer capture on any button-up, including a secondary button.
                root.release-pointer();
            }
        }
        moved => {
            if root.dragging {
                root.scratch-pointer(1, (self.mouse-x - root.width / 2) / 1px, (self.mouse-y - root.height / 2) / 1px);
            }
        }
    }
    keys := FocusScope {
        width: 0; height: 0;
        focus-lost(reason) => { root.release-pointer(); }
    }
    if root.dragging && root.mouse-owned && root.touched : Rectangle {
        x: touch.mouse-x - 14px; y: touch.mouse-y - 14px;
        width: 28px; height: 28px;
        border-radius: 14px; background: #f4f4f2;
        accessible-role: image;
        accessible-label: root.deck-label + " scratch drag hand";
        Image {
            x: 2px; y: 2px; width: 24px; height: 24px;
            source: @image-url("../assets/drag-hand-gesture.svg");
            image-fit: contain;
        }
    }
}

export component ChannelMeter inherits Rectangle {
    in property <string> deck;
    in property <string> caption;
    in property <float> level;
    in property <bool> clipped;
    in property <bool> warning;
    callback clear();
    background: DjTheme.panel-bg;
    HorizontalLayout {
        padding: 2px; spacing: 4px;
        Rectangle {
            background: DjTheme.panel-dark;
            accessible-role: image;
            accessible-label: "Deck " + root.deck + " pre-fader sample peak";
            accessible-description: root.caption + ". Latest complete 50 ms window after EQ/filter/trim and before faders; LAST marks inactive transport and shows the latest produced window. Not true peak or hardware timing.";
            Rectangle { width: parent.width * clamp(root.level,0,1); background: root.warning ? #b03535 : #216546; }
            Text { text: root.caption; color: DjTheme.text-primary; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; }
        }
        Button { width: 72px; text: root.clipped ? "CLIP" : "CLEAR"; enabled: root.clipped; accessible-label: "Deck " + root.deck + " clear clip hold"; clicked => { root.clear(); } }
    }
}

export component HotCuePad inherits Rectangle {
    in property <int> slot;
    in property <string> label;
    in property <string> text;
    in property <string> description;
    in property <bool> occupied;
    in property <bool> cue-enabled;
    in property <color> tint;
    callback held(int, bool, int);
    property <int> active-input: 0;
    function begin-input(input: int) {
        if root.active-input == 0 {
            root.active-input = input;
            root.held(root.slot, true, input);
        }
    }
    function end-input(input: int) {
        if root.active-input == input {
            root.active-input = 0;
            root.held(root.slot, false, input);
        }
    }
    function cancel-input() {
        let input = root.active-input;
        root.active-input = 0;
        if input != 0 {
            root.held(root.slot, false, input);
        }
    }
    height: 27px;
    background: root.active-input != 0 ? DjTheme.control-pressed : DjTheme.control-bg;
    border-radius: 3px;
    opacity: root.cue-enabled ? 1 : 0.4;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description + ". Hold to preview from a paused deck.";
    accessible-enabled: root.cue-enabled;
    accessible-action-default => {
        if root.cue-enabled && root.active-input == 0 {
            root.begin-input(4);
            root.end-input(4);
        }
    }
    changed cue-enabled => {
        if !root.cue-enabled {
            root.cancel-input();
        }
    }
    Text {
    font-size: 11px;
    overflow: elide;
        text: root.text;
        color: root.occupied ? root.tint : DjTheme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.cue-enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                keys.focus();
                root.begin-input(1);
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.end-input(1);
            } else if event.kind == PointerEventKind.cancel {
                root.end-input(1);
            }
        }
    }
    keys := FocusScope {
        width: 0; height: 0;
        enabled: root.cue-enabled;
        focus-lost(reason) => { root.cancel-input(); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if !event.repeat {
                    root.begin-input(event.text == Key.Space ? 2 : 3);
                }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.end-input(event.text == Key.Space ? 2 : 3);
                return accept;
            }
            return reject;
        }
    }
}

export // A temporary rate must always have a matching release, including focus/cancel paths.
component NudgeHold inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled;
    callback held(bool);
    callback cancel();
    // First input owns this gesture; other inputs need a fresh press after release.
    property <int> active-input: 0;
    function begin-input(input: int) { if root.active-input == 0 { root.active-input = input; root.held(true); } }
    function end-input(input: int) { if root.active-input == input { root.active-input = 0; root.held(false); } }
    function cancel-input() { root.active-input = 0; root.cancel(); }
    height: 28px;
    background: root.active-input != 0 ? DjTheme.control-pressed : DjTheme.control-bg;
    border-radius: 4px;
    border-width: keys.has-focus ? 1px : 0px; border-color: DjTheme.focus-border;
    opacity: enabled ? 1 : 0.4;
    forward-focus: keys;
    accessible-role: button; accessible-label: label;
    accessible-description: "Hold pointer, Space or Return; first input owns the gesture until release";
    accessible-enabled: enabled;
    // An accessibility click is instantaneous, so it cannot latch a rate.
    accessible-action-default => { if root.enabled && root.active-input == 0 { root.begin-input(4); root.end-input(4); } }
    changed enabled => { if !self.enabled { root.cancel-input(); } }
    Text { text: root.text; color: DjTheme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                keys.focus(); root.begin-input(1);
            } else if event.kind == PointerEventKind.cancel {
                root.end-input(1);
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.end-input(1);
            }
        }
    }
    keys := FocusScope {
        width: 0; // Pointer input belongs to the TouchArea, which explicitly focuses us.
        enabled: root.enabled;
        focus-lost(reason) => { root.cancel-input(); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { if !event.repeat { root.begin-input(event.text == Key.Space ? 2 : 3); } return accept; }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.end-input(event.text == Key.Space ? 2 : 3); return accept; }
            return reject;
        }
    }
}

export component LibraryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();
    min-width: label.preferred-width + 14px;
    preferred-width: label.preferred-width + 14px;
    horizontal-stretch: 0;
    height: 22px;
    background: active ? #07577e : (touch.has-hover && enabled ? #343434 : #242424);
    border-color: focus.has-focus ? #eeeeee : (active ? #258db5 : #414141);
    border-width: 1px;
    border-radius: 2px;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    label := Text {
        text: root.text; font-size: 11px;
        color: root.enabled ? #eeeeee : #777777;
        horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
}

export component DjAction inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> accent: DjTheme.selection-bg;
    in property <color> ink: DjTheme.text-primary;
    in property <length> text-size: 11px;
    callback clicked();
    property <bool> keyboard-pressed: false;
    min-width: 24px;
    preferred-width: label.preferred-width + 16px;
    horizontal-stretch: 0;
    height: DjTheme.control-height;
    background: !root.enabled ? DjTheme.panel-bg :
        (touch.pressed || root.keyboard-pressed ? DjTheme.control-pressed :
        (root.active ? root.accent : (touch.has-hover ? DjTheme.control-hover : DjTheme.control-bg)));
    border-width: 1px;
    border-color: keys.has-focus ? DjTheme.focus-border : DjTheme.divider;
    border-radius: 1px;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-description: "Application action; result is published by the existing controller.";
    accessible-action-default => { if root.enabled { root.clicked(); } }
    changed enabled => { if !root.enabled { root.keyboard-pressed = false; } }

    label := Text {
        text: root.text;
        font-family: DjTheme.font-ui;
        font-size: root.text-size;
        color: root.enabled ? root.ink : DjTheme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { keys.focus(); root.clicked(); }
    }
    keys := FocusScope {
        width: 0px; height: 0px;
        enabled: root.enabled;
        focus-lost(reason) => { root.keyboard-pressed = false; }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if !event.repeat { root.keyboard-pressed = true; }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.keyboard-pressed {
                    root.keyboard-pressed = false;
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
    }
}

