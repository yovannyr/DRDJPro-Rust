export global ModernTheme {
    in property <color> background: #0b0d10;
    in property <color> surface: #11151a;
    in property <color> raised: #181d24;
    in property <color> line: #2d333c;
    in property <color> text: #edf1f5;
    in property <color> muted: #919ba9;
    in property <color> green: #62dd96;
    in property <color> blue: #5fa9ff;
    in property <color> purple: #bc96ff;
    in property <color> orange: #edb16b;
}
