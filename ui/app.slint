import { Button, Slider, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct BeatLine { position: float, downbeat: bool }

component DeckPanel inherits Rectangle {
    in property <string> deck-label;
    in property <brush> accent;
    in property <[float]> waveform;
    in property <[float]> detail;
    in property <[color]> waveform-colors;
    in property <[color]> detail-colors;
    in property <[BeatLine]> beats;
    in property <bool> grid-active;
    in property <string> grid-caption: "GRID OFF";
    in-out property <int> grid-bpm: 120;
    in property <float> detail-start;
    in property <float> detail-end: 100;
    in property <float> detail-marker;
    in-out property <int> detail-window: 8;
    in property <bool> audio-enabled: false;
    in property <bool> loaded: false;
    in property <bool> loading: false;
    in property <string> track-title: "DEMO TRACK";
    in property <string> time-text: "SIMULATION";
    in-out property <bool> playing;
    in-out property <float> position;
    callback play-clicked();
    callback cue-clicked();
    callback load-clicked();
    callback seek-requested(float);
    callback zoom-changed();
    callback grid-clicked();
    callback clear-grid-clicked();

    background: #151e2d;
    border-radius: 10px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text {
            text: deck-label;
            color: accent;
            font-size: 21px;
            font-weight: 700;
        }
        Text {
            text: track-title;
            overflow: elide;
            color: #c4d0df;
            font-size: 13px;
        }
        Button {
            text: "LOAD MP3 / WAV";
            accessible-label: deck-label + " load track";
            enabled: audio-enabled && !loading;
            clicked => { load-clicked(); }
        }
        overview := Rectangle {
            height: 56px;
            background: #0a1220;
            clip: true;
            for value[i] in waveform : Rectangle {
                x: i * parent.width / max(1, waveform.length);
                y: (parent.height - self.height) / 2;
                width: parent.width / max(1, waveform.length);
                height: clamp(value, 0, 1) * (parent.height - 16px);
                background: i < waveform-colors.length ? waveform-colors[i] : accent;
            }
            Rectangle {
                accessible-role: image;
                accessible-label: deck-label + " waveform playhead";
                accessible-value: position;
                x: clamp(position, 0, 100) / 100 * max(0px, parent.width - self.width);
                width: 2px;
                height: parent.height;
                background: #f9fafc;
            }
            TouchArea {
                enabled: !audio-enabled || loaded;
                accessible-role: slider;
                accessible-label: deck-label + " waveform overview";
                accessible-enabled: self.enabled;
                accessible-value: position;
                accessible-value-minimum: 0;
                accessible-value-maximum: 100;
                accessible-action-set-value(v) => {
                    if self.enabled && v.is-float() {
                        if audio-enabled { root.seek-requested(v.to-float()); }
                        else { position = clamp(v.to-float(), 0, 100); }
                    }
                }
                clicked => {
                    if self.width > 0px {
                        let target = clamp(100 * self.mouse-x / self.width, 0, 100);
                        if audio-enabled { root.seek-requested(target); }
                        else { position = target; }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "DETAIL ≤ " + detail-window + " s";
                color: #9bacbf;
                vertical-alignment: center;
            }
            Button {
                text: "+";
                accessible-label: deck-label + " zoom in";
                enabled: audio-enabled && loaded && detail-window > 2;
                clicked => { detail-window = max(2, detail-window / 2); root.zoom-changed(); }
            }
            Button {
                text: "−";
                accessible-label: deck-label + " zoom out";
                enabled: audio-enabled && loaded && detail-window < 32;
                clicked => { detail-window = min(32, detail-window * 2); root.zoom-changed(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "BPM"; color: #9bacbf; vertical-alignment: center; }
            SpinBox {
                accessible-label: deck-label + " manual BPM";
                enabled: audio-enabled && loaded;
                minimum: 40;
                maximum: 240;
                value <=> grid-bpm;
            }
            Button {
                text: "GRID HERE";
                accessible-label: deck-label + " set beatgrid";
                enabled: audio-enabled && loaded;
                clicked => { root.grid-clicked(); }
            }
        }
        Rectangle {
            height: 100px;
            background: #0a1220;
            clip: true;
            for value[i] in detail : Rectangle {
                x: i * parent.width / max(1, detail.length);
                y: (parent.height - self.height) / 2;
                width: parent.width / max(1, detail.length);
                height: clamp(value, 0, 1) * (parent.height - 12px);
                background: i < detail-colors.length ? detail-colors[i] : accent;
            }
            for line in beats : Rectangle {
                accessible-role: image;
                accessible-label: deck-label + " beat line";
                accessible-value: line.position;
                x: clamp(line.position, 0, 100) / 100 * max(0px, parent.width - self.width);
                width: line.downbeat ? 2px : 1px;
                height: parent.height;
                background: line.downbeat ? #ffffff99 : #ffffff40;
            }
            Rectangle {
                accessible-role: image;
                accessible-label: deck-label + " detail playhead";
                accessible-value: detail-marker;
                x: clamp(detail-marker, 0, 100) / 100 * max(0px, parent.width - self.width);
                width: 2px;
                height: parent.height;
                background: #f9fafc;
            }
            TouchArea {
                enabled: audio-enabled && loaded;
                accessible-role: slider;
                accessible-label: deck-label + " detailed waveform";
                accessible-enabled: self.enabled;
                accessible-value: position;
                accessible-value-minimum: detail-start;
                accessible-value-maximum: detail-end;
                accessible-action-set-value(v) => {
                    if self.enabled && v.is-float() {
                        root.seek-requested(clamp(v.to-float(), detail-start, detail-end));
                    }
                }
                clicked => {
                    if self.width > 0px {
                        let fraction = clamp(self.mouse-x / self.width, 0, 1);
                        root.seek-requested(detail-start + fraction * (detail-end - detail-start));
                    }
                }
            }
        }
        Text {
            text: time-text + "  /  " + round(position) + "%";
            color: #9bacbf;
            font-size: 12px;
        }
        Slider {
            enabled: !audio-enabled || loaded;
            accessible-label: deck-label + " position";
            minimum: 0;
            maximum: 100;
            value <=> position;
            changed(value) => { if audio-enabled { root.seek-requested(value); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: playing ? "PAUSE" : "PLAY";
                enabled: !audio-enabled || loaded;
                accessible-label: deck-label + " play/pause";
                clicked => { play-clicked(); }
            }
            Button {
                text: "CUE";
                enabled: !audio-enabled || loaded;
                accessible-label: deck-label + " cue";
                clicked => { cue-clicked(); }
            }
            Button {
                text: "GRID OFF";
                accessible-label: deck-label + " clear beatgrid";
                enabled: grid-active;
                clicked => { root.clear-grid-clicked(); }
            }
        }
        Rectangle { background: transparent; vertical-stretch: 1; }
        HorizontalLayout {
            Text { text: root.audio-enabled ? "BASS" : "SIMULATED"; color: #ea5a5a; font-size: 11px; }
            Text { text: root.audio-enabled ? "MID" : "NO AUDIO"; color: #46dc64; font-size: 11px; }
            Text { text: root.audio-enabled ? "HIGH" : "SYNTHETIC"; color: #508cfa; font-size: 11px; }
        }
        Text { text: grid-caption; color: #9bacbf; font-size: 11px; }
    }
}

export component AppWindow inherits Window {
    title: "DrDJ Pro — Rust UI Spike";
    preferred-width: 1200px;
    preferred-height: 740px;
    min-width: 850px;
    min-height: 680px;
    background: #0b111c;

    in property <[float]> left-waveform;
    in property <[float]> right-waveform;
    in property <[float]> left-detail;
    in property <[float]> right-detail;
    in property <[color]> left-waveform-colors;
    in property <[color]> right-waveform-colors;
    in property <[color]> left-detail-colors;
    in property <[color]> right-detail-colors;
    in property <[BeatLine]> left-beats;
    in property <[BeatLine]> right-beats;
    in property <bool> left-grid-active;
    in property <bool> right-grid-active;
    in property <string> left-grid-caption: "GRID OFF";
    in property <string> right-grid-caption: "GRID OFF";
    in-out property <int> left-grid-bpm: 120;
    in-out property <int> right-grid-bpm: 120;
    in property <float> left-detail-start;
    in property <float> left-detail-end: 100;
    in property <float> left-detail-marker;
    in property <float> right-detail-start;
    in property <float> right-detail-end: 100;
    in property <float> right-detail-marker;
    in-out property <int> left-detail-window: 8;
    in-out property <int> right-detail-window: 8;
    in property <bool> audio-enabled: false;
    in property <bool> loading: false;
    in property <bool> left-loaded: false;
    in property <bool> right-loaded: false;
    in property <string> left-title: "DEMO TRACK";
    in property <string> right-title: "DEMO TRACK";
    in property <string> left-time: "SIMULATION";
    in property <string> right-time: "SIMULATION";
    in property <string> status;
    in-out property <float> channel-a: 1;
    in-out property <float> channel-b: 1;
    in-out property <float> crossfader: 0.5;
    in-out property <bool> left-playing: false;
    in-out property <bool> right-playing: false;
    in-out property <float> left-position: 0;
    in-out property <float> right-position: 0;
    callback toggle-left();
    callback toggle-right();
    callback reset-left();
    callback reset-right();
    callback load-left();
    callback load-right();
    callback mixer-changed();
    callback seek-left(float);
    callback seek-right(float);
    callback zoom-left();
    callback zoom-right();
    callback grid-left();
    callback grid-right();
    callback clear-grid-left();
    callback clear-grid-right();

    VerticalLayout {
        padding: 18px;
        spacing: 16px;
        Text {
            text: "DrDJ Pro    /    RUST UI PROTOTYPE";
            color: #f1f5fb;
            font-size: 23px;
            font-weight: 700;
            vertical-alignment: center;
            height: 48px;
        }
        HorizontalLayout {
            spacing: 12px;
            DeckPanel {
                deck-label: "DECK A";
                accent: #36c9ef;
                playing <=> root.left-playing;
                position <=> root.left-position;
                waveform: root.left-waveform;
                waveform-colors: root.left-waveform-colors;
                detail-colors: root.left-detail-colors;
                beats: root.left-beats;
                grid-active: root.left-grid-active;
                grid-caption: root.left-grid-caption;
                grid-bpm <=> root.left-grid-bpm;
                grid-clicked => { root.grid-left(); }
                clear-grid-clicked => { root.clear-grid-left(); }
                detail: root.left-detail;
                detail-start: root.left-detail-start;
                detail-end: root.left-detail-end;
                detail-marker: root.left-detail-marker;
                detail-window <=> root.left-detail-window;
                zoom-changed => { root.zoom-left(); }
                audio-enabled: root.audio-enabled;
                loaded: root.left-loaded;
                loading: root.loading;
                track-title: root.left-title;
                time-text: root.left-time;
                load-clicked => { root.load-left(); }
                seek-requested(value) => { root.seek-left(value); }
                play-clicked => { root.toggle-left(); }
                cue-clicked => { root.reset-left(); }
            }
            Rectangle {
                width: 220px;
                background: #151e2d;
                border-radius: 10px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    Text {
                        text: "MIXER";
                        color: #f0f4ff;
                        font-size: 19px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text { text: "CHANNEL A"; color: #36c9ef; font-size: 12px; }
                    Slider { accessible-label: "Channel A fader"; minimum: 0; maximum: 1; value <=> root.channel-a; changed => { root.mixer-changed(); } }
                    Text { text: "CHANNEL B"; color: #ffae58; font-size: 12px; }
                    Slider { accessible-label: "Channel B fader"; minimum: 0; maximum: 1; value <=> root.channel-b; changed => { root.mixer-changed(); } }
                    Text { text: "CROSSFADER"; color: #d7e1ef; font-size: 12px; }
                    Slider { accessible-label: "Crossfader"; minimum: 0; maximum: 1; value <=> root.crossfader; changed => { root.mixer-changed(); } }
                    Rectangle { background: transparent; vertical-stretch: 1; }
                    Text {
                        text: root.audio-enabled ? "LINEAR AUDIO MIX" : "UI DEMO ONLY";
                        color: #8b9ab2;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
            DeckPanel {
                deck-label: "DECK B";
                accent: #ffae58;
                playing <=> root.right-playing;
                position <=> root.right-position;
                waveform: root.right-waveform;
                waveform-colors: root.right-waveform-colors;
                detail-colors: root.right-detail-colors;
                beats: root.right-beats;
                grid-active: root.right-grid-active;
                grid-caption: root.right-grid-caption;
                grid-bpm <=> root.right-grid-bpm;
                grid-clicked => { root.grid-right(); }
                clear-grid-clicked => { root.clear-grid-right(); }
                detail: root.right-detail;
                detail-start: root.right-detail-start;
                detail-end: root.right-detail-end;
                detail-marker: root.right-detail-marker;
                detail-window <=> root.right-detail-window;
                zoom-changed => { root.zoom-right(); }
                audio-enabled: root.audio-enabled;
                loaded: root.right-loaded;
                loading: root.loading;
                track-title: root.right-title;
                time-text: root.right-time;
                load-clicked => { root.load-right(); }
                seek-requested(value) => { root.seek-right(value); }
                play-clicked => { root.toggle-right(); }
                cue-clicked => { root.reset-right(); }
            }
        }
        Rectangle {
            height: 66px;
            background: #151e2d;
            border-radius: 10px;
            HorizontalLayout {
                padding: 15px;
                spacing: 20px;
                Text {
                    text: "LIBRARY";
                    color: #f1f5fb;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.status;
                    overflow: elide;
                    color: #92a2b9;
                    vertical-alignment: center;
                }
            }
        }
    }
}
