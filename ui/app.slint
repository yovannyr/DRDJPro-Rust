    callback select-crate(int); callback target-crate(int);
    callback new-crate(); callback new-smart-crate(); callback new-subcrate(); callback rename-crate(); callback delete-crate();
    callback save-crate-name(); callback confirm-delete-crate(); callback cancel-crate-dialog();
    callback add-to-crate(); callback remove-from-crate();
    keyboard-scope := FocusScope {
        width: 100%; height: 100%;
        focus-lost(reason) => { root.release-active-hot-cue-key(); }
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && event.modifiers.shift {
                if event.text == Key.LeftArrow {
                    if !event.repeat { root.load-library-left(); }
                    return accept;
                }
                if event.text == Key.RightArrow {
                    if !event.repeat { root.load-library-right(); }
                    return accept;
                }
            }
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            let index = root.hot-cue-key-index(event.text);
            if index < 0 {
                return reject;
            }
            if event.repeat || root.active-hot-cue-key == index {
                return accept;
            }
            if root.active-hot-cue-key >= 0 {
                return reject;
            }
            root.active-hot-cue-key = index;
            if index < 5 {
                root.hold-hot-cue-left(index, true, 5);
            } else {
                root.hold-hot-cue-right(index - 5, true, 5);
            }
            return accept;
        }
        key-released(event) => {
            let index = root.hot-cue-key-index(event.text);
            if index != root.active-hot-cue-key {
                return reject;
            }
            root.release-active-hot-cue-key();
            return accept;
        }
    VerticalLayout {
        HorizontalLayout {
            height: 24px; spacing: 4px;
            LibraryButton {
                text: "2 DECKS"; active: !root.four-decks;
                clicked => {
                    if root.four-decks {
                        root.four-decks = false;
                        root.layout-changed();
                    }
                }
            }
            LibraryButton {
                text: "4 SLOTS"; active: root.four-decks;
                clicked => {
                    if !root.four-decks {
                        root.four-decks = true;
                        root.layout-changed();
                    }
                }
            }
            ComboBox {
                width: 130px; model: ["Classic", "Modern"];
                current-index: root.layout-index;
                accessible-label: "Performance layout";
                selected => {
                    let selected-mode = self.current-index == 1 ? LayoutMode.Modern : LayoutMode.Classic;
                    if root.view-mode != selected-mode {
                        root.view-mode = selected-mode;
                        root.layout-changed();
                    }
                }
            }
            Text { text: root.four-decks ? "A/B APP • C/D DATA PLACEHOLDERS" : "A/B APP • TWO-DECK VIEW"; color: DjTheme.text-secondary; font-size: 10px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }

        padding: 8px; spacing: 4px;
        HorizontalLayout {
            height: 32px;
            Text { text: "DRDJ PRO"; color: #f1f4fa; font-size: 21px; font-weight: 800; vertical-alignment: center; }
            ComboBox { width:110px; model:root.output-pair-options; current-index <=> root.output-pair-index; accessible-label:"Audio output pair"; accessible-description:"Stereo mix output pair on the current audio device"; enabled:root.quantize-preferences-ready && root.audio-enabled && root.output-pair-options.length>1; selected => { root.output-pair-changed(); } }
            Text { width:100px; text:root.output-profile-status; accessible-label:"Audio output profile"; color:#9cacc1; font-size:10px; vertical-alignment:center; overflow:elide; }
            CheckBox { text: "QUANTIZE"; accessible-label: "Global Quantize"; accessible-description: "Enable selected cue and auto-loop quantization on both decks; disabling cancels queued cue triggers and retains deck preferences"; checked <=> root.quantize-enabled; enabled: root.quantize-preferences-ready; toggled => { root.quantize-mode-changed(); } }
            Text { text: "Ansicht"; color: #d3dce8; font-size: 11px; vertical-alignment: center; }
            deck-view-selector := ComboBox {
                width: 150px;
                model: ["Training", "Virtuelle Decks"];
                current-index <=> root.deck-view-index;
                enabled: root.mc4000-connected;
                accessible-label: "Deck view";
                accessible-description: "Choose training or round virtual decks";
            }
        }
        if root.audio-startup-warning != "" : Rectangle {
            height:28px;background:#6a2e20;
            Text {text:"AUDIO OUTPUT NOTICE — check AUDIO settings before playback";color:#fff1de;vertical-alignment:center;
                accessible-label:"Audio startup fallback warning";accessible-description:root.audio-startup-warning;}
        }
        GridLayout {
            visible: root.view-mode == LayoutMode.Classic;
            height: root.view-mode == LayoutMode.Classic ? 344px + (root.four-decks ? 124px : 0px) : 0px;
            spacing: 4px;
            left-deck := CompactDeck {
            row: 0; col: 0;

                pad-sampler: root.left-pad-sampler; pad-mode => { root.pad-mode(0,true,false); }
                platter-mouse-owned: root.left-platter-mouse-owned;
                scratch-pointer(action, x, y) => { root.virtual-platter-pointer(0, action, x, y); }
                deck-label: "DECK A"; controller-mode: root.virtual-decks-visible; accent: DjTheme.deck-a; track-title: root.left-title; time-text: root.left-time;
                platter-bpm: root.left-platter-bpm; platter-time: root.left-platter-time;
                platter-angle: root.left-platter-angle; platter-touched: root.left-platter-touched;
                censor: root.left-censor;
                external-hover: root.external-drop-deck == 0;
                accepts-drop(data) => { return root.accepts-track-drop(0,data); }
                drop-track(data) => { return root.drop-track(0,data); }
                waveform: root.left-waveform; colors: root.left-waveform-colors;
                pitch-range-index <=> root.left-pitch-range-index; pitch-min: root.left-pitch-min; pitch-max: root.left-pitch-max; pitch-outside: root.left-pitch-outside; pitch-can-down: root.left-pitch-can-down; pitch-can-up: root.left-pitch-can-up;
                pitch-range => { root.pitch-range-left(); } pitch-down => { root.pitch-down-left(); } pitch-up => { root.pitch-up-left(); }
                pitch-percent <=> root.left-pitch-percent; pitch-caption: root.left-pitch-caption; bpm-caption: root.left-bpm-caption;
                nudge(direction, held) => { root.nudge-left(direction, held); } cancel-nudge => { root.cancel-nudge-left(); }
                pitch(value) => { root.pitch-left(value); } reset-pitch => { root.reset-pitch-left(); }
                can-match-tempo: root.left-can-match-tempo; match-tempo => { root.match-tempo-left(); }
                can-phase-sync: root.left-can-phase-sync; phase-sync => { root.phase-sync-left(); }
                sync-active: root.left-sync-active; sync-preparing: root.left-sync-preparing; can-sync: root.left-can-sync; toggle-sync => { root.toggle-sync-left(); }
                alignment-index <=> root.left-alignment-index; alignment-mode => { root.alignment-mode-left(); }
                grid-active: root.left-grid-active; auto-loop-index <=> root.left-auto-loop-index; auto-loop-snap <=> root.left-auto-loop-snap;
                auto-loop => { root.auto-loop-left(); } half-loop => { root.half-loop-left(); } double-loop => { root.double-loop-left(); }
                saved-loops: root.left-saved-loops; saved-loop-slot <=> root.left-saved-loop-slot; saved-loop-name <=> root.left-saved-loop-name;
                save-loop => { root.save-loop-left(); } recall-loop => { root.recall-loop-left(); } delete-loop => { root.delete-loop-left(); }
                loop-range: root.left-loop-range;
                loop-caption: root.left-loop-caption; loop-has-in: root.left-loop-has-in; loop-ready: root.left-loop-ready; loop-active: root.left-loop-active;
                loop-jog-mode: root.left-loop-jog-mode;
                cancel-loop-jog => { root.controller-loop-jog(0, 0); }
                loop-jog => { root.controller-loop-jog(0, root.left-loop-jog-mode == 0 ? 1 : (root.left-loop-jog-mode == 1 ? 2 : 0)); }
                loop-in => { root.loop-in-left(); } loop-out => { root.loop-out-left(); } loop-activate => { root.loop-activate-left(); } reloop => { root.reloop-left(); }
                hot-cues: root.left-hot-cues;
                quantize-cues <=> root.left-quantize-cues;
                quantize-enabled: root.quantize-enabled;
                quantize-preferences-ready: root.quantize-preferences-ready;
                quantize-triggers <=> root.left-quantize-triggers;
                quantize-step <=> root.left-quantize-step;
                keylock <=> root.left-keylock; keylock-change => { root.keylock-left(); }
                cancel-trigger => { root.cancel-trigger-left(); }
                cue-editing: root.left-cue-editing; cue-name <=> root.left-cue-name; cue-rgb <=> root.left-cue-rgb;
                edit-hot-cue(slot) => { root.edit-hot-cue-left(slot); }
                save-hot-cue => { root.save-hot-cue-left(); } cancel-hot-cue => { root.cancel-hot-cue-left(); }
                hot-cue(slot, held, input) => { root.hold-hot-cue-left(slot, held, input); }
                delete-hot-cue(slot) => { root.delete-hot-cue-left(slot); }
                playing: root.left-playing; position <=> root.left-position;
                audio-enabled: root.audio-enabled; loaded: root.left-loaded; loading: root.left-busy; load-busy: root.loading || root.library-busy;
                temporary-cue(held) => { root.temporary-cue(0, held, false); } stutter => { root.stutter(0); }
                load => { root.load-left(); } toggle => { root.toggle-left(); } cue => { root.reset-left(); } eject => { root.eject-left(); } seek(value) => { root.seek-left(value); }
            }
            right-deck := CompactDeck {
            row: 0; col: 1;

                pad-sampler: root.right-pad-sampler; pad-mode => { root.pad-mode(1,true,false); }
                platter-mouse-owned: root.right-platter-mouse-owned;
                scratch-pointer(action, x, y) => { root.virtual-platter-pointer(1, action, x, y); }
                deck-label: "DECK B"; controller-mode: root.virtual-decks-visible; accent: DjTheme.deck-b; track-title: root.right-title; time-text: root.right-time;
                platter-bpm: root.right-platter-bpm; platter-time: root.right-platter-time;
                platter-angle: root.right-platter-angle; platter-touched: root.right-platter-touched;
                censor: root.right-censor;
                external-hover: root.external-drop-deck == 1;
                accepts-drop(data) => { return root.accepts-track-drop(1,data); }
                drop-track(data) => { return root.drop-track(1,data); }
                waveform: root.right-waveform; colors: root.right-waveform-colors;
                pitch-range-index <=> root.right-pitch-range-index; pitch-min: root.right-pitch-min; pitch-max: root.right-pitch-max; pitch-outside: root.right-pitch-outside; pitch-can-down: root.right-pitch-can-down; pitch-can-up: root.right-pitch-can-up;
                pitch-range => { root.pitch-range-right(); } pitch-down => { root.pitch-down-right(); } pitch-up => { root.pitch-up-right(); }
                pitch-percent <=> root.right-pitch-percent; pitch-caption: root.right-pitch-caption; bpm-caption: root.right-bpm-caption;
                nudge(direction, held) => { root.nudge-right(direction, held); } cancel-nudge => { root.cancel-nudge-right(); }
                pitch(value) => { root.pitch-right(value); } reset-pitch => { root.reset-pitch-right(); }
                can-match-tempo: root.right-can-match-tempo; match-tempo => { root.match-tempo-right(); }
                can-phase-sync: root.right-can-phase-sync; phase-sync => { root.phase-sync-right(); }
                sync-active: root.right-sync-active; sync-preparing: root.right-sync-preparing; can-sync: root.right-can-sync; toggle-sync => { root.toggle-sync-right(); }
                alignment-index <=> root.right-alignment-index; alignment-mode => { root.alignment-mode-right(); }
                grid-active: root.right-grid-active; auto-loop-index <=> root.right-auto-loop-index; auto-loop-snap <=> root.right-auto-loop-snap;
                auto-loop => { root.auto-loop-right(); } half-loop => { root.half-loop-right(); } double-loop => { root.double-loop-right(); }
                saved-loops: root.right-saved-loops; saved-loop-slot <=> root.right-saved-loop-slot; saved-loop-name <=> root.right-saved-loop-name;
                save-loop => { root.save-loop-right(); } recall-loop => { root.recall-loop-right(); } delete-loop => { root.delete-loop-right(); }
                loop-range: root.right-loop-range;
