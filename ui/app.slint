                loop-jog-mode: root.right-loop-jog-mode;
                cancel-loop-jog => { root.controller-loop-jog(1, 0); }
                loop-jog => { root.controller-loop-jog(1, root.right-loop-jog-mode == 0 ? 1 : (root.right-loop-jog-mode == 1 ? 2 : 0)); }
                loop-in => { root.loop-in-right(); } loop-out => { root.loop-out-right(); } loop-activate => { root.loop-activate-right(); } reloop => { root.reloop-right(); }
                hot-cues: root.right-hot-cues;
                quantize-cues <=> root.right-quantize-cues;
                quantize-enabled: root.quantize-enabled;
                quantize-preferences-ready: root.quantize-preferences-ready;
                quantize-triggers <=> root.right-quantize-triggers;
                quantize-step <=> root.right-quantize-step;
                keylock <=> root.right-keylock; keylock-change => { root.keylock-right(); }
                cancel-trigger => { root.cancel-trigger-right(); }
                cue-editing: root.right-cue-editing; cue-name <=> root.right-cue-name; cue-rgb <=> root.right-cue-rgb;
                edit-hot-cue(slot) => { root.edit-hot-cue-right(slot); }
                save-hot-cue => { root.save-hot-cue-right(); } cancel-hot-cue => { root.cancel-hot-cue-right(); }
                hot-cue(slot, held, input) => { root.hold-hot-cue-right(slot, held, input); }
                delete-hot-cue(slot) => { root.delete-hot-cue-right(slot); }
                playing: root.right-playing; position <=> root.right-position;
                audio-enabled: root.audio-enabled; loaded: root.right-loaded; loading: root.right-busy; load-busy: root.loading || root.library-busy;
                temporary-cue(held) => { root.temporary-cue(1, held, false); } stutter => { root.stutter(1); }
                load => { root.load-right(); } toggle => { root.toggle-right(); } cue => { root.reset-right(); } eject => { root.eject-right(); } seek(value) => { root.seek-right(value); }
            }

        DeckPlaceholder {
            row: 1; col: 0; deck-label: "DECK C"; accent: DjTheme.deck-c;
            collapsed: !root.four-decks; track-data: root.deck-c-data;
            waveform: root.deck-c-waveform; colors: root.deck-c-colors;
        }
