    callback library-change-page(int);
    in property <string> library-storage: "Session library";
    in property <bool> library-save-failed;
    callback retry-library-save();
    in property <string> library-empty: "Add audio files to your library";
    in property <bool> library-busy: false;
    in property <int> selected-track: -1;
    in property <bool> library-can-relocate-selected: false;
    in-out property <string> library-query;
    callback import-library(); callback import-library-folder(); callback library-search(); callback select-library(int); callback relocate-library-track();
    callback move-library-selection(int); callback sort-library(int);
    callback load-library-left(); callback load-library-right();
    in property <[CrateRow]> crate-rows;
    in property <[string]> crate-names;
    in property <int> selected-crate;
    in property <bool> selected-crate-smart;
    in-out property <int> target-crate-index;
    in property <bool> crate-editor-open;
    in property <bool> crate-delete-pending;
    in property <string> crate-dialog-title;
    in-out property <string> crate-edit-name;
    in property <bool> crate-editor-smart;
    in-out property <string> crate-edit-smart-query;
    callback select-crate(int); callback target-crate(int);
    callback new-crate(); callback new-smart-crate(); callback new-subcrate(); callback rename-crate(); callback delete-crate();
    callback save-crate-name(); callback confirm-delete-crate(); callback cancel-crate-dialog();
    callback add-to-crate(); callback remove-from-crate();
    keyboard-scope := FocusScope {
        width: 100%; height: 100%;
        focus-lost(reason) => { root.release-active-hot-cue-key(); }
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            let index = root.hot-cue-key-index(event.text);
            if index < 0 {
                return reject;
            }
            if event.repeat || root.active-hot-cue-key == index {
                return accept;
            }
            if root.active-hot-cue-key >= 0 {
                return reject;
            }
            root.active-hot-cue-key = index;
            if index < 5 {
                root.hold-hot-cue-left(index, true, 5);
            } else {
                root.hold-hot-cue-right(index - 5, true, 5);
            }
            return accept;
        }
        key-released(event) => {
            let index = root.hot-cue-key-index(event.text);
            if index != root.active-hot-cue-key {
                return reject;
            }
            root.release-active-hot-cue-key();
            return accept;
        }
    VerticalLayout {
