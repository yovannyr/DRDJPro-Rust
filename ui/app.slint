// DRDJPRO CONNECTED LAYOUT — generated from local source
import "layout-fonts/LiberationSans-Regular.ttf";
import "layout-fonts/LiberationSans-Bold.ttf";
import "layout-fonts/LiberationMono-Regular.ttf";
import { DjTheme, LoopRange, SavedLoopRow, HotCueRow, CrateRow, BeatLine, LibraryRow, TableColumn, DeckView, SamplerRow, DeckSlotData } from "theme.slint";
export { LoopRange, SavedLoopRow, HotCueRow, CrateRow, BeatLine, LibraryRow, TableColumn, DeckView, SamplerRow, DeckSlotData } from "theme.slint";
import { LayoutMode } from "layout-modes.slint";
import { DeckAction, HoldAction, ControlKind, JogPhase } from "modern-state.slint";
import { ModernView } from "modern-view.slint";
import { VirtualPlatter, ChannelMeter, HotCuePad, NudgeHold, LibraryButton, DjAction } from "controls.slint";
import { WaveformStrip, DetailWaveform } from "waveform.slint";
import { CompactDeck, DeckPlaceholder } from "deck.slint";
import { CratePanel, TrackLibrary } from "library.slint";
import { EqStrip, FxStrip } from "editors.slint";

import { Button, Slider, SpinBox, LineEdit, ListView, ComboBox, CheckBox, Palette } from "std-widgets.slint";


































export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    default-font-family: DjTheme.font-ui;
    default-font-size: 12px;
    // Layout-only view state; A/B source data and engine ownership stay unchanged.
    in-out property <bool> four-decks: false;
    in-out property <LayoutMode> view-mode: LayoutMode.Classic;
    out property <int> layout-index: root.view-mode == LayoutMode.Classic ? 0 : 1;
    in-out property <bool> modern-library-open: true;
    callback layout-changed();
    // Modern view callbacks
    callback modern-action(int, DeckAction);
    callback modern-hold-started(int, HoldAction, int);
    callback modern-hold-ended(int, HoldAction, int);
    callback modern-hold-canceled(int, HoldAction, int);
    callback modern-control-requested(int, ControlKind, float);
    callback modern-gesture-ended(int);
    callback modern-jog(int, JogPhase, float, float);
    callback modern-seek-requested(int, float);
    callback modern-detail-zoom(int, int);
    callback library-toggle();
    modern-action(deck, action) => {
        if deck == 0 {
            if action == DeckAction.load { root.load-left(); }
            else if action == DeckAction.play-pause { root.toggle-left(); }
            else if action == DeckAction.sync { root.toggle-sync-left(); }
            else if action == DeckAction.keylock { root.left-keylock = !root.left-keylock; root.keylock-left(); }
            else if action == DeckAction.quantize { root.quantize-enabled = !root.quantize-enabled; }
            else if action == DeckAction.loop-toggle {
                if root.left-loop-active { root.loop-exit-left(); } else { root.loop-activate-left(); }
            }
            else if action == DeckAction.loop-half { root.half-loop-left(); }
            else if action == DeckAction.loop-double { root.double-loop-left(); }
            else if action == DeckAction.monitor { root.monitor-cue-a = !root.monitor-cue-a; root.monitor-cue-changed(0); }
            else if action == DeckAction.fx { root.usb-finder-open=false; root.fx-open = true; }
            else if action == DeckAction.edit { root.grid-left(); }
        } else if deck == 1 {
            if action == DeckAction.load { root.load-right(); }
            else if action == DeckAction.play-pause { root.toggle-right(); }
            else if action == DeckAction.sync { root.toggle-sync-right(); }
            else if action == DeckAction.keylock { root.right-keylock = !root.right-keylock; root.keylock-right(); }
            else if action == DeckAction.quantize { root.quantize-enabled = !root.quantize-enabled; }
            else if action == DeckAction.loop-toggle {
                if root.right-loop-active { root.loop-exit-right(); } else { root.loop-activate-right(); }
            }
            else if action == DeckAction.loop-half { root.half-loop-right(); }
            else if action == DeckAction.loop-double { root.double-loop-right(); }
            else if action == DeckAction.monitor { root.monitor-cue-b = !root.monitor-cue-b; root.monitor-cue-changed(1); }
            else if action == DeckAction.fx { root.usb-finder-open=false; root.fx-open = true; }
            else if action == DeckAction.edit { root.grid-right(); }
        }
    }
    modern-hold-started(deck, action, slot) => {
        if deck == 0 {
            if action == HoldAction.cue { root.temporary-cue(0, true, false); }
            else if action == HoldAction.hot-cue { root.hold-hot-cue-left(slot, true, 5); }
            else if action == HoldAction.nudge-backward { root.nudge-left(-1, true); }
            else if action == HoldAction.nudge-forward { root.nudge-left(1, true); }
        } else if deck == 1 {
            if action == HoldAction.cue { root.temporary-cue(1, true, false); }
            else if action == HoldAction.hot-cue { root.hold-hot-cue-right(slot, true, 5); }
            else if action == HoldAction.nudge-backward { root.nudge-right(-1, true); }
            else if action == HoldAction.nudge-forward { root.nudge-right(1, true); }
        }
    }
    modern-hold-ended(deck, action, slot) => {
        if deck == 0 {
            if action == HoldAction.cue { root.temporary-cue(0, false, false); }
            else if action == HoldAction.hot-cue { root.hold-hot-cue-left(slot, false, 5); }
            else if action == HoldAction.nudge-backward { root.nudge-left(-1, false); }
            else if action == HoldAction.nudge-forward { root.nudge-left(1, false); }
        } else if deck == 1 {
            if action == HoldAction.cue { root.temporary-cue(1, false, false); }
            else if action == HoldAction.hot-cue { root.hold-hot-cue-right(slot, false, 5); }
            else if action == HoldAction.nudge-backward { root.nudge-right(-1, false); }
            else if action == HoldAction.nudge-forward { root.nudge-right(1, false); }
        }
    }
    modern-hold-canceled(deck, action, slot) => {
        if deck == 0 {
            if action == HoldAction.cue { root.temporary-cue(0, false, false); }
            else if action == HoldAction.hot-cue { root.hold-hot-cue-left(slot, false, 5); }
            else if action == HoldAction.nudge-backward { root.cancel-nudge-left(); }
            else if action == HoldAction.nudge-forward { root.cancel-nudge-left(); }
        } else if deck == 1 {
            if action == HoldAction.cue { root.temporary-cue(1, false, false); }
            else if action == HoldAction.hot-cue { root.hold-hot-cue-right(slot, false, 5); }
            else if action == HoldAction.nudge-backward { root.cancel-nudge-right(); }
            else if action == HoldAction.nudge-forward { root.cancel-nudge-right(); }
        }
    }
    modern-control-requested(deck, kind, value) => {
        if deck == -1 && kind == ControlKind.crossfader {
            root.crossfader = value;
            root.mixer-changed();
        } else if deck == 0 {
            if kind == ControlKind.gain { root.eq-trim-a = value * 24 - 12; root.eq-changed(0); }
            else if kind == ControlKind.high { root.eq-high-a = value * 36 - 24; root.eq-changed(0); }
            else if kind == ControlKind.mid { root.eq-mid-a = value * 36 - 24; root.eq-changed(0); }
            else if kind == ControlKind.low { root.eq-low-a = value * 36 - 24; root.eq-changed(0); }
            else if kind == ControlKind.filter { root.eq-filter-a = value * 2 - 1; root.eq-changed(0); }
            else if kind == ControlKind.volume { root.channel-a = value; root.mixer-changed(); }
            else if kind == ControlKind.pitch { root.pitch-left(root.left-pitch-min + value * (root.left-pitch-max - root.left-pitch-min)); }
        } else if deck == 1 {
            if kind == ControlKind.gain { root.eq-trim-b = value * 24 - 12; root.eq-changed(1); }
            else if kind == ControlKind.high { root.eq-high-b = value * 36 - 24; root.eq-changed(1); }
            else if kind == ControlKind.mid { root.eq-mid-b = value * 36 - 24; root.eq-changed(1); }
            else if kind == ControlKind.low { root.eq-low-b = value * 36 - 24; root.eq-changed(1); }
            else if kind == ControlKind.filter { root.eq-filter-b = value * 2 - 1; root.eq-changed(1); }
            else if kind == ControlKind.volume { root.channel-b = value; root.mixer-changed(); }
            else if kind == ControlKind.pitch { root.pitch-right(root.right-pitch-min + value * (root.right-pitch-max - root.right-pitch-min)); }
        }
    }
    modern-jog(deck, phase, x, y) => {
        if deck >= 0 && deck < 2 {
            let action = phase == JogPhase.begin ? 0 : (phase == JogPhase.move ? 1 : 2);
            root.virtual-platter-pointer(deck, action, x, y);
        }
    }
    modern-seek-requested(deck, position) => {
        if deck == 0 { root.seek-left(position); }
        else if deck == 1 { root.seek-right(position); }
    }
    modern-detail-zoom(deck, step) => {
        if deck == 0 {
            if root.left-loaded {
                let next = step < 0 ? max(2, root.left-detail-window / 2) : min(32, root.left-detail-window * 2);
                if next != root.left-detail-window { root.left-detail-window = next; root.zoom-left(); }
            }
        }
        else if deck == 1 {
            if root.right-loaded {
                let next = step < 0 ? max(2, root.right-detail-window / 2) : min(32, root.right-detail-window * 2);
                if next != root.right-detail-window { root.right-detail-window = next; root.zoom-right(); }
            }
        }
    }
    library-toggle() => { root.modern-library-open = !root.modern-library-open; }
    out property <int> visible-layout-slots: root.four-decks ? 4 : 2;
    out property <int> supported-audio-deck-count: 2;
    in-out property <DeckSlotData> deck-c-data;
    in-out property <DeckSlotData> deck-d-data;
    in-out property <[float]> deck-c-waveform;
    in-out property <[float]> deck-d-waveform;
    in-out property <[color]> deck-c-colors;
    in-out property <[color]> deck-d-colors;

    in property <bool> left-platter-mouse-owned;
    in property <bool> right-platter-mouse-owned;
    callback virtual-platter-pointer(int, int, float, float);
    callback controller-jog(int, int);
    callback controller-seek-hold(int, int, bool);
    callback controller-navigation-shift(bool);
    callback controller-loop-boundary(int, int);
    callback controller-loop-jog(int, int);
    in property <int> left-loop-jog-mode;
    in property <int> right-loop-jog-mode;
    callback controller-platter-touch(int, bool);
    callback controller-vinyl(int);
    callback controller-censor(int, bool);
    in property <bool> left-censor;
    in property <bool> right-censor;
    callback controller-pitch-fader(int, int);
    callback controller-pitch-range-left();
    callback controller-pitch-range-right();
    callback controller-bend-left(int, bool);
    callback controller-bend-right(int, bool);
    callback controller-sync(int, bool);
    callback controller-four-bar-loop(int);
    callback controller-hot-cue(int, int, bool, bool);
    callback pad-mode(int, bool, bool);
    in property <bool> left-pad-sampler;
    in property <bool> right-pad-sampler;
    callback temporary-cue(int, bool, bool);
    callback stutter(int);
    callback controller-browse(int);
    callback controller-browser-action(int);
    callback controller-cancel-load-gesture();
    in-out property <bool> controller-browser-crates;
    out property <bool> controller-editor-open: root.crate-editor-open || root.left-grid-editing || root.right-grid-editing || root.left-cue-editing || root.right-cue-editing || left-deck.loop-name-focused || right-deck.loop-name-focused;
    out property <bool> controller-search-focused: track-library.search-focused;
    callback focus-library-tracks();
    focus-library-tracks => { track-library.focus-tracks(); }
    callback reveal-library-row(int);
    reveal-library-row(index) => { track-library.reveal-row(index); }
    in-out property <bool> controller-shift;
    in-out property <float> left-platter-angle: 0;
    in-out property <float> right-platter-angle: 0;
    in-out property <bool> left-platter-touched: false;
    in-out property <bool> right-platter-touched: false;
    in property <bool> left-vinyl: true;
    in property <bool> right-vinyl: true;
    in property <[TableColumn]> table-columns;
    in property <[TableColumn]> all-table-columns;
    in property <float> table-width;
    in property <int> table-sort-field;
    in property <bool> table-sort-descending;
    in property <bool> table-columns-enabled: true;
    in-out property <length> table-scroll-x;
    callback change-table-column(int, int);
    pure callback track-transfer(string) -> data-transfer;
    pure callback accepts-track-drop(int, data-transfer) -> bool;
    callback drop-track(int, data-transfer) -> bool;
    in property <int> external-drop-deck: -1;
    in-out property <string> library-performance;
    pure callback external-drop-target(float, float) -> int;
    external-drop-target(px, py) => {
        if !root.audio-enabled || root.audio-device-open || root.monitor-open || root.fx-open || root.sampler-open || root.usb-finder-open {
            return -1;
        }
        if root.view-mode == LayoutMode.Modern {
            return modern-view.external-drop-target(px, py);
        }
        if root.view-mode == LayoutMode.Classic {
            if px >= left-deck.absolute-position.x / 1px && px < (left-deck.absolute-position.x + left-deck.width) / 1px
                && py >= left-deck.absolute-position.y / 1px && py < (left-deck.absolute-position.y + left-deck.height) / 1px {
                return 0;
            }
            if px >= right-deck.absolute-position.x / 1px && px < (right-deck.absolute-position.x + right-deck.width) / 1px
                && py >= right-deck.absolute-position.y / 1px && py < (right-deck.absolute-position.y + right-deck.height) / 1px {
                return 1;
            }
        }
        return -1;
    }
    title: "DrDJ Pro"; preferred-width: 1280px; preferred-height: 860px;
    min-width: 850px; min-height: (root.four-decks ? 1020px : 860px) + (root.eq-open ? 120px : 0px) + (root.left-grid-editing ? 110px : 0px) + (root.right-grid-editing ? 110px : 0px); background: DjTheme.app-bg;
    in-out property <int> active-hot-cue-key: -1;
    function hot-cue-key-index(key: string) -> int {
        return key == "1" || key == "!" ? 0
            : key == "2" || key == "@" ? 1
            : key == "3" || key == "#" ? 2
            : key == "4" || key == "$" ? 3
            : key == "5" || key == "%" ? 4
            : key == "6" || key == "^" ? 5
            : key == "7" || key == "&" ? 6
            : key == "8" || key == "*" ? 7
            : key == "9" || key == "(" ? 8
            : key == "0" || key == ")" ? 9
            : -1;
    }
    function release-active-hot-cue-key() {
        let index = root.active-hot-cue-key;
        if index < 0 {
            return;
        }
        root.active-hot-cue-key = -1;
        if index < 5 {
            root.hold-hot-cue-left(index, false, 5);
        } else {
            root.hold-hot-cue-right(index - 5, false, 5);
        }
    }
    forward-focus: keyboard-scope;
    in property <[float]> left-waveform;
    in property <[float]> right-waveform;
    in property <[float]> left-detail;
    in property <[float]> right-detail;
    in property <[color]> left-waveform-colors;
    in property <[color]> right-waveform-colors;
    in property <[color]> left-detail-colors;
    in property <[color]> right-detail-colors;
    in property <[BeatLine]> left-beats;
    in property <[BeatLine]> right-beats;
    in property <bool> left-grid-active;
    in property <bool> right-grid-active;
    in property <string> left-grid-caption: "GRID OFF";
    in property <string> right-grid-caption: "GRID OFF";
    in-out property <int> left-grid-bpm: 120;
    in-out property <int> right-grid-bpm: 120;
    in property <int> left-suggested-bpm: 0;
    in property <int> right-suggested-bpm: 0;
    in property <float> left-detail-start;
    in property <float> left-detail-end: 100;
    in property <float> left-detail-marker;
    in property <float> right-detail-start;
    in property <float> right-detail-end: 100;
    in property <float> right-detail-marker;
    in-out property <int> left-detail-window: 8;
    in-out property <int> right-detail-window: 8;
    in property <bool> audio-enabled: false;
    in property <[string]> output-pair-options: ["OUT 1/2"];
    in property <string> output-profile-status: "Session only";
    in-out property <int> output-pair-index: 0;
    callback output-pair-changed();
    changed output-pair-index => { root.output-pair-changed(); }
    in-out property <bool> quantize-enabled: true;
    in property <bool> quantize-preferences-ready: true;
    callback quantize-mode-changed();
    changed quantize-enabled => { root.quantize-mode-changed(); }
    in property <bool> loading: false;
    in property <bool> background-job-active;
    callback cancel-background-job();
    in property <bool> left-busy: false;
    in property <bool> right-busy: false;
    in property <bool> left-loaded: false;
    in property <bool> right-loaded: false;
    in property <string> left-title: "DEMO TRACK";
    in property <string> right-title: "DEMO TRACK";
    in property <string> left-artist;
    in property <string> right-artist;
    in property <string> left-musical-key;
    in property <string> right-musical-key;
    in property <color> left-cover: #00000000;
    in property <color> right-cover: #00000000;
    in property <string> left-time: "SIMULATION";
    in property <string> right-time: "SIMULATION";
    in property <string> status;
    in property <string> controller-status;
    in-out property <bool> usb-finder-open: false;
    in property <[string]> usb-device-names;
    in-out property <int> usb-device-choice: -1;
    in property <string> usb-finder-status: "Open the finder to scan USB devices";
    in property <string> usb-device-details;
    in property <bool> usb-inspecting: false;
    callback usb-refresh();
    callback usb-inspect();
    callback usb-selection-changed();
    in property <bool> mc4000-connected: false;
    in-out property <int> deck-view-index: 0;
    out property <DeckView> deck-view: root.deck-view-index == 1 ? DeckView.virtual : DeckView.training;
    out property <bool> virtual-decks-visible: root.mc4000-connected && root.deck-view == DeckView.virtual;
    changed mc4000-connected => { root.deck-view-index = root.mc4000-connected ? 1 : 0; }
    in-out property <string> left-platter-bpm: "—";
    in-out property <string> right-platter-bpm: "—";
    in-out property <string> left-platter-time: "—";
    in-out property <string> right-platter-time: "—";
    in-out property <bool> controller-reconnect-requested: false;
    in property<string> output-peak-caption:"BUS PEAK —";
    in property<float> output-peak-level:0;
    in property<bool> output-peak-warning:false;
    in-out property <float> channel-a: 1;
    in-out property <float> channel-b: 1;
    in-out property <float> crossfader: 0.5;
    in-out property <bool> eq-open: false;
    in-out property <float> eq-trim-a: 0;
    in-out property <float> eq-low-a: 0;
    in-out property <float> eq-mid-a: 0;
    in-out property <float> eq-high-a: 0;
    in-out property <float> eq-filter-a: 0;
    in-out property <float> eq-trim-b: 0;
    in-out property <float> eq-low-b: 0;
    in-out property <float> eq-mid-b: 0;
    in-out property <float> eq-high-b: 0;
    in-out property <float> eq-filter-b: 0;
    callback eq-changed(int);
    callback clear-channel-clip(int);
    in-out property <bool> fx-open:false;
    changed fx-open => { if !root.fx-open { root.fx-tap-cancel(0); root.fx-tap-cancel(1); } }
    in-out property <bool> fx-active-a:false;
    in-out property <bool> fx-active-b:false;
    in-out property <float> fx-time-a:250;
    in-out property <float> fx-time-b:250;
    in-out property <float> fx-feedback-a:30;
    in-out property <float> fx-feedback-b:30;
    in-out property <float> fx-wet-a:25;
    in-out property <float> fx-wet-b:25;
    in-out property <int> fx-slot-a:1;
    in-out property <int> fx-slot-b:1;
    in property <string> fx-status:"FX session only";
    callback fx-changed(int);
    callback fx-preset(int,int,bool);
    in-out property <int> fx-base-a;
    in-out property <int> fx-base-b;
    in-out property <int> fx-division-a:4;
    in-out property <int> fx-division-b:4;
    in property <string> fx-timing-a;
    in property <string> fx-timing-b;
    in property <bool> fx-time-available-a:true;
    in property <bool> fx-time-available-b:true;
    in property <bool> fx-chain-ready;
    in-out property <bool> sampler-open:false;
