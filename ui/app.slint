                Button {text:root.audio-device-scanning ? "SCANNING…":"REFRESH";accessible-label:"Refresh audio devices";enabled:!root.audio-device-scanning && !root.audio-device-saving && !root.audio-device-switching;clicked=>{root.audio-device-scan();}}
                Button {text:root.audio-device-saving ? "SAVING…":"SAVE FOR NEXT START";accessible-label:"Save next startup audio device";enabled:root.audio-device-ready && !root.audio-device-scanning && !root.audio-device-saving && !root.audio-device-switching;clicked=>{root.audio-device-save();}}
                Button {text:root.audio-device-switching ? "SWITCHING…":"APPLY NOW";accessible-label:"Apply audio device now";enabled:root.audio-device-ready && !root.audio-device-scanning && !root.audio-device-saving && !root.audio-device-switching;clicked=>{root.audio-device-apply();}}
                Button {text:"REOPEN CURRENT";accessible-label:"Reopen current audio output";enabled:root.audio-device-ready && !root.audio-device-scanning && !root.audio-device-saving && !root.audio-device-switching;clicked=>{root.audio-device-reopen();}}
            }
            Text {text:root.audio-device-status;color:DjTheme.text-primary;wrap:word-wrap;}
        }
    }
    if root.usb-finder-open : Rectangle {
        x:16px; y:60px; width:parent.width - 32px; height:min(360px, parent.height - 90px);
        background:DjTheme.panel-dark; border-width:1px; border-color:#53657d;
        accessible-role:groupbox; accessible-label:"USB device finder panel";
        TouchArea { }
        VerticalLayout {
            padding:10px; spacing:8px;
            HorizontalLayout {
                Text { text:"USB DEVICE FINDER"; color:DjTheme.text-primary; }
                Button { text:"REFRESH"; accessible-label:"Refresh USB devices"; clicked=>{root.usb-refresh();} }
                Button { text:"CLOSE"; accessible-label:"Close USB device finder"; clicked=>{root.usb-finder-open=false;} }
            }
            Text { text:root.usb-finder-status; color:DjTheme.text-primary; wrap:word-wrap; }
            ComboBox {
                accessible-label:"USB device selection"; model:root.usb-device-names;
                current-index <=> root.usb-device-choice;
                selected(_)=>{root.usb-selection-changed();}
            }
            Button { text:root.usb-inspecting ? "READING…" : "READ DEVICE STRINGS";
                accessible-label:"Read selected USB device strings";
                enabled:root.usb-device-choice >= 0 && !root.usb-inspecting;
                clicked=>{root.usb-inspect();}
            }
            Text { accessible-role:text; accessible-label:"USB device details";
                text:root.usb-device-details; color:DjTheme.text-primary; wrap:word-wrap; vertical-stretch:1; }
        }
    }
    if root.monitor-open : Rectangle {
        x:16px;y:60px;width:parent.width - 32px;height:270px;
        background:DjTheme.panel-dark;border-width:1px;border-color:#53657d;
        accessible-role:groupbox;accessible-label:"Headphone monitor panel";
        VerticalLayout {
            padding:10px;spacing:8px;
            HorizontalLayout {
                Text {text:"HEADPHONE CUE — OUT 3/4";color:DjTheme.text-primary;}
                Button {text:"CLOSE MON";accessible-label:"Close headphone monitor";clicked=>{root.monitor-open=false;}}
            }
            Text {text:root.monitor-status;color:DjTheme.text-primary;}
            HorizontalLayout {
                CheckBox {text:"CUE A (pre-fader)";accessible-label:"Deck A headphone cue";enabled:root.monitor-available;checked <=> root.monitor-cue-a;toggled=>{root.monitor-cue-changed(0);}}
                CheckBox {text:"CUE B (pre-fader)";accessible-label:"Deck B headphone cue";enabled:root.monitor-available;checked <=> root.monitor-cue-b;toggled=>{root.monitor-cue-changed(1);}}
                CheckBox {text:"SPLIT CUE";accessible-label:"Split headphone cue";accessible-description:"Cue mono left, master mono right; mix and level remain active";enabled:root.monitor-available;checked <=> root.monitor-split; toggled=>{root.monitor-changed();}}
            }
            Text {text:"HEADPHONE LEVEL " + round(root.monitor-gain) + "%";color:DjTheme.text-primary;}
            Slider {accessible-label:"Headphone monitor gain";enabled:root.monitor-available;minimum:0;maximum:100;value <=> root.monitor-gain; changed => { root.monitor-changed(); }}
            Text {text:root.monitor-split ? "CUE mono L ← BALANCE " + round(root.monitor-mix) + "% → MASTER mono R" : "CUE ← MIX " + round(root.monitor-mix) + "% → MASTER";color:DjTheme.text-primary;}
            Slider {accessible-label:"Headphone cue master mix";enabled:root.monitor-available;minimum:0;maximum:100;value <=> root.monitor-mix; changed => { root.monitor-changed(); }}
            Text {text:"Settings follow audio profile status. MC4000 Monitor Level / Pan control these sliders.";color:#a6b4c8;}
        }
    }
    if root.sampler-open : Rectangle {
        x:16px;y:60px;width:parent.width - 32px;height:340px;
        background:DjTheme.panel-dark;border-width:1px;border-color:#53657d;
        accessible-role:groupbox;accessible-label:"Four-slot sampler";
        VerticalLayout {
            padding:10px;spacing:8px;
            HorizontalLayout {Text {text:root.sampler-status;color:DjTheme.text-primary;overflow:elide;}Button {text:"STOP ALL";accessible-label:"Stop all sampler slots";clicked=>{root.sampler-action(0,4,false);}}Button {text:"CLOSE";accessible-label:"Close sampler";clicked=>{root.sampler-open=false;}}}
            for slot[index] in root.sampler-slots : HorizontalLayout {
                Text {text:(index+1)+" · "+slot.name+(slot.playing ? " · PLAYING" : slot.busy ? " · PREPARING" : "");color:slot.playing ? #ffc15e : DjTheme.text-primary;overflow:elide;horizontal-stretch:1;}
                Button {text:"LOAD";accessible-label:"Sampler slot "+(index+1)+" load";enabled:root.sampler-ready && !root.sampler-loading;clicked=>{root.sampler-action(index,2,false);}}
                Button {text:"PLAY";accessible-label:"Sampler slot "+(index+1)+" play";enabled:root.sampler-ready && slot.loaded && !slot.busy;clicked=>{root.sampler-action(index,0,false);}}
                Button {text:"STOP";accessible-label:"Sampler slot "+(index+1)+" stop";clicked=>{root.sampler-action(index,1,false);}}
                Button {text:"CLEAR";accessible-label:"Sampler slot "+(index+1)+" clear";enabled:slot.occupied || slot.busy;clicked=>{root.sampler-action(index,3,false);}}
            }
            Text {text:"SAMPLER LEVEL "+round(root.sampler-gain)+"% · One-shot / retrigger · 4 voices";color:DjTheme.text-secondary;}
            Slider {minimum:0;maximum:100;value <=> root.sampler-gain;enabled:root.sampler-ready;accessible-label:"Sampler master level"; changed => { root.sampler-level(); }}
            Text {text:"Mono/stereo, up to10s /480000 source frames. Restored samples stay stopped.";color:#a6b4c8;}
        }
    }
    if root.fx-open : Rectangle {
        x:16px;y:60px;width:parent.width - 32px;height:480px;
        background:DjTheme.panel-dark;border-width:1px;border-color:#53657d;
        accessible-role:groupbox;accessible-label:"Delay effects panel";
        VerticalLayout {
            padding:8px;spacing:6px;
            HorizontalLayout {Text {text:root.fx-status;color:DjTheme.text-primary;} Button {text:"CLOSE FX";accessible-label:"Close delay effects";clicked=>{root.fx-tap-cancel(0);root.fx-tap-cancel(1);root.fx-open=false;}}}
            HorizontalLayout {
                spacing:8px;
                FxStrip {deck:"A";summary:root.fx-summary-a;selected-slot <=> root.fx-selected-a;effect-kind <=> root.fx-kind-a;legacy <=> root.fx-legacy-a;slot-action(slot,action,value)=>{root.fx-slot-action(0,slot,action,value);}legacy-changed(value)=>{root.fx-legacy-changed(0,value);}time-base <=> root.fx-base-a;division <=> root.fx-division-a;timing:root.fx-timing-a;timing-changed(base,division)=>{root.fx-timing-changed(0,base,division);}tap(held)=>{root.fx-tap(0,held);}tap-cancel=>{root.fx-tap-cancel(0);}ready:root.quantize-preferences-ready;active <=> root.fx-active-a;time <=> root.fx-time-a;feedback <=> root.fx-feedback-a;wet <=> root.fx-wet-a;slot <=> root.fx-slot-a;changed => {root.fx-changed(0);}preset(slot,save)=>{root.fx-preset(0,slot,save);}}
                FxStrip {deck:"B";summary:root.fx-summary-b;selected-slot <=> root.fx-selected-b;effect-kind <=> root.fx-kind-b;legacy <=> root.fx-legacy-b;slot-action(slot,action,value)=>{root.fx-slot-action(1,slot,action,value);}legacy-changed(value)=>{root.fx-legacy-changed(1,value);}time-base <=> root.fx-base-b;division <=> root.fx-division-b;timing:root.fx-timing-b;timing-changed(base,division)=>{root.fx-timing-changed(1,base,division);}tap(held)=>{root.fx-tap(1,held);}tap-cancel=>{root.fx-tap-cancel(1);}ready:root.quantize-preferences-ready;active <=> root.fx-active-b;time <=> root.fx-time-b;feedback <=> root.fx-feedback-b;wet <=> root.fx-wet-b;slot <=> root.fx-slot-b;changed => {root.fx-changed(1);}preset(slot,save)=>{root.fx-preset(1,slot,save);}}
            }
        }
        }
    }
}
