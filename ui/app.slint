import { Button, Slider, SpinBox, LineEdit, ListView, ComboBox, CheckBox } from "std-widgets.slint";
export struct LoopRange { valid: bool, active: bool, visible: bool, in-visible: bool, out-visible: bool, start: float, end: float, description: string }
export struct SavedLoopRow { occupied: bool, description: string }
export struct HotCueRow { occupied: bool, description: string, tint: color, position: float, valid: bool, name: string }
export struct CrateRow { id: int, name: string, count: int }
export struct BeatLine { position: float, downbeat: bool, first: bool, bar: int }
export struct LibraryRow { id: int, name: string, artist: string, album: string, duration: string, metadata-error: string, format: string, path: string, available: bool }

component WaveformStrip inherits Rectangle {
    in property <string> deck-label;
    in property <bool> overview;
    in property <brush> accent;
    in property <[float]> values;
    in property <[color]> colors;
    in property <[BeatLine]> beats;
    in property <[HotCueRow]> hot-cues;
    in property <LoopRange> loop-range;
    in property <bool> enabled;
    in property <float> position;
    in property <float> marker;
    in property <float> range-start: 0;
    in property <float> range-end: 100;
    callback seek(float);
    background: #070b11; clip: true;
    Rectangle {
        visible: root.loop-range.visible;
        accessible-role: image; accessible-label: root.deck-label + (root.overview ? " overview loop range" : " detail loop range");
        accessible-description: root.loop-range.description;
        x: min(clamp(root.loop-range.start / 100, 0, 1) * parent.width, max(0px,parent.width - 1px));
        width: min(max(1px, max(0, root.loop-range.end - root.loop-range.start) / 100 * parent.width), max(0px,parent.width - self.x));
        height: parent.height; background: root.loop-range.active ? #36dfa333 : #a8b3c31c;
    }
    for value[i] in values : Rectangle {
        x: i * parent.width / max(1, values.length);
        y: (parent.height - self.height) / 2;
        width: parent.width / max(1, values.length);
        height: clamp(value, 0, 1) * max(0px, parent.height - 6px);
        background: i < colors.length ? colors[i] : accent;
    }
    for line in beats : Rectangle {
        accessible-role: image; accessible-label: deck-label + " beat line"; accessible-value: line.position;
        x: clamp(line.position, 0, 100) / 100 * max(0px, parent.width - self.width);
        width: line.downbeat ? 2px : 1px; height: parent.height;
        background: line.first ? #ff4444 : (line.downbeat ? #ffffff99 : #ffffff40);
    }
    for line in beats : Text {
        visible: line.downbeat; x: clamp(line.position,0,100)/100*max(0px,parent.width - 14px); y: 1px;
        text: "" + line.bar; color: line.first ? #ff5555 : #dfe8f5; font-size: 10px;
        accessible-role: text; accessible-label: deck-label + " bar label"; accessible-description: "Bar " + line.bar;
    }
    Rectangle {
        visible: root.loop-range.in-visible;
        accessible-role: image; accessible-label: root.deck-label + (root.overview ? " overview loop in" : " detail loop in"); accessible-value: root.loop-range.start;
        x: clamp(root.loop-range.start / 100,0,1)*max(0px,parent.width - self.width);
        width: 2px; height: parent.height; background: root.loop-range.active ? #36dfa3 : #a8b3c3;
        Text { x: 3px; y: 14px; text: "IN"; color: parent.background; font-size: 9px; }
    }
    Rectangle {
        visible: root.loop-range.out-visible;
        accessible-role: image; accessible-label: root.deck-label + (root.overview ? " overview loop out" : " detail loop out"); accessible-value: root.loop-range.end;
        x: clamp(root.loop-range.end / 100,0,1)*max(0px,parent.width - self.width);
        width: 2px; height: parent.height; background: root.loop-range.active ? #36dfa3 : #a8b3c3;
        Text { x: -22px; y: 14px; text: "OUT"; color: parent.background; font-size: 9px; }
    }
    for cue[i] in hot-cues : Rectangle {
        visible: cue.valid && range-end > range-start && cue.position >= range-start && cue.position <= range-end;
        accessible-role: image; accessible-label: deck-label + (overview ? " overview cue marker " : " detail cue marker ") + (i + 1);
        accessible-description: cue.description; accessible-value: cue.position;
        x: clamp((cue.position - range-start) / max(0.000001, range-end - range-start), 0, 1) * max(0px, parent.width - self.width);
        width: 2px; height: parent.height; background: cue.tint;
        Text { x: 3px; y: max(0px, parent.height - 14px); width: 110px; text: "" + (i + 1) + " " + cue.name; color: cue.tint; font-size: 10px; overflow: elide; }
    }
    Rectangle {
        accessible-role: image;
        accessible-label: deck-label + (overview ? " waveform playhead" : " detail playhead");
        accessible-value: marker;
        x: clamp(marker, 0, 100) / 100 * max(0px, parent.width - self.width);
        width: 2px; height: parent.height; background: #ffffff;
    }
    TouchArea {
        enabled: root.enabled; accessible-role: slider;
        accessible-label: deck-label + (overview ? " waveform overview" : " detailed waveform");
        accessible-enabled: self.enabled; accessible-value: position;
        accessible-value-minimum: range-start; accessible-value-maximum: range-end;
        accessible-action-set-value(v) => { if self.enabled && v.is-float() { root.seek(clamp(v.to-float(), range-start, range-end)); } }
        clicked => { if self.width > 0px { root.seek(range-start + clamp(self.mouse-x / self.width, 0, 1) * (range-end - range-start)); } }
    }
}

// A temporary rate must always have a matching release, including focus/cancel paths.
component NudgeHold inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled;
    callback held(bool);
    callback cancel();
    // First input owns this gesture; other inputs need a fresh press after release.
    property <int> active-input: 0;
    function begin-input(input: int) { if root.active-input == 0 { root.active-input = input; root.held(true); } }
    function end-input(input: int) { if root.active-input == input { root.active-input = 0; root.held(false); } }
    function cancel-input() { root.active-input = 0; root.cancel(); }
    height: 28px;
    background: root.active-input != 0 ? #365472 : #243448;
    border-radius: 4px;
    border-width: keys.has-focus ? 1px : 0px; border-color: #77baff;
    opacity: enabled ? 1 : 0.4;
    forward-focus: keys;
    accessible-role: button; accessible-label: label;
    accessible-description: "Hold pointer, Space or Return; first input owns the gesture until release";
    accessible-enabled: enabled;
    // An accessibility click is instantaneous, so it cannot latch a rate.
    accessible-action-default => { if root.enabled && root.active-input == 0 { root.begin-input(4); root.end-input(4); } }
    changed enabled => { if !self.enabled { root.cancel-input(); } }
    Text { text: root.text; color: #dfe8f5; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                keys.focus(); root.begin-input(1);
            } else if event.kind == PointerEventKind.cancel {
                root.end-input(1);
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.end-input(1);
            }
        }
    }
    keys := FocusScope {
        width: 0; // Pointer input belongs to the TouchArea, which explicitly focuses us.
        enabled: root.enabled;
        focus-lost(reason) => { root.cancel-input(); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { if !event.repeat { root.begin-input(event.text == Key.Space ? 2 : 3); } return accept; }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.end-input(event.text == Key.Space ? 2 : 3); return accept; }
            return reject;
        }
    }
}

component CompactDeck inherits Rectangle {
    in property <string> deck-label;
    in property <brush> accent;
    in property <string> track-title;
    in property <string> time-text;
    in property <[float]> waveform;
    in property <[color]> colors;
    in property <bool> audio-enabled;
    in property <bool> loaded;
    in property <bool> loading;
    in property <bool> load-busy;
    in property <bool> playing;
    in-out property <float> position;
    in property <[HotCueRow]> hot-cues;
    in property <LoopRange> loop-range;
    property <int> delete-slot: 1;
    property <int> tools-panel: 0;
    in property <bool> grid-active;
    in-out property <int> pitch-range-index: 3;
    in property <float> pitch-min: -50;
    in property <float> pitch-max: 100;
    in property <bool> pitch-outside;
    in property <bool> pitch-can-down;
    in property <bool> pitch-can-up;
    callback nudge(int, bool); callback cancel-nudge();
    callback pitch-range(); callback pitch-down(); callback pitch-up();
    in-out property <float> pitch-percent;
    in property <string> pitch-caption;
    in property <string> bpm-caption;
    callback pitch(float); callback reset-pitch();
    in-out property <int> auto-loop-index: 5;
    in-out property <bool> auto-loop-snap: false;
    callback auto-loop(); callback half-loop(); callback double-loop();
    in property <[SavedLoopRow]> saved-loops;
    in-out property <int> saved-loop-slot: 1;
    in-out property <string> saved-loop-name;
    callback save-loop(); callback recall-loop(); callback delete-loop();
    in property <string> loop-caption;
    in property <bool> loop-has-in;
    in property <bool> loop-ready;
    in property <bool> loop-active;
    callback loop-in(); callback loop-out(); callback loop-activate(); callback loop-exit();
    in property <bool> cue-editing;
    in-out property <string> cue-name;
    in-out property <string> cue-rgb;
    callback edit-hot-cue(int); callback save-hot-cue(); callback cancel-hot-cue();
    callback hot-cue(int); callback delete-hot-cue(int);
    callback load(); callback toggle(); callback cue(); callback seek(float);
    background: #171c24; border-width: 1px; border-color: #303b4b;
    VerticalLayout {
        padding: 8px; spacing: 4px;
        HorizontalLayout {
            Text { text: deck-label + " / INT"; color: accent; font-weight: 700; font-size: 15px; }
            Button { text: "LOAD"; accessible-label: deck-label + " load track"; enabled: audio-enabled && !loading && !load-busy && !playing; clicked => { root.load(); } }
            Button { text: playing ? "PAUSE" : "PLAY"; accessible-label: deck-label + " play/pause"; enabled: !audio-enabled || loaded; clicked => { root.toggle(); } }
            Button { text: "CUE"; accessible-label: deck-label + " cue"; enabled: !audio-enabled || loaded; clicked => { root.cue(); } }
        }
        Text { text: track-title; color: #f1f3f7; font-size: 16px; overflow: elide; }
        WaveformStrip {
            height: 42px; overview: true; deck-label: root.deck-label; accent: root.accent;
            values: root.waveform; colors: root.colors; hot-cues: root.hot-cues; loop-range: root.loop-range; position: root.position; marker: root.position;
            enabled: !audio-enabled || loaded;
            seek(value) => { if audio-enabled { root.seek(value); } else { root.position = value; } }
        }
        HorizontalLayout {
            Text { text: "ELAPSED / TOTAL  " + time-text; color: #a8b3c3; font-size: 11px; }
            Text { text: round(position) + "%"; color: accent; font-size: 11px; horizontal-alignment: right; }
        }
        Slider { minimum: 0; maximum: 100; value <=> position; accessible-label: deck-label + " position"; enabled: !audio-enabled || loaded; changed(value) => { if audio-enabled { root.seek(value); } } }
        if root.tools-panel == 0 : HorizontalLayout {
            spacing: 2px; height: 30px;
            for pad[i] in hot-cues : VerticalLayout {
                spacing: 0px;
                Button {
                    text: "" + (i + 1) + (pad.occupied ? " ●" : " +");
                    accessible-label: deck-label + " hot cue " + (i + 1);
                    accessible-description: pad.description;
                    enabled: loaded && !loading;
                    clicked => { root.hot-cue(i); }
                }
                Rectangle { height: 3px; background: pad.occupied ? pad.tint : #394251; }
            }
        }
        HorizontalLayout {
            height: 28px; spacing: 2px;
            Button { text: "IN"; accessible-label: root.deck-label + " loop in"; enabled: loaded && !loading; clicked => { root.loop-in(); } }
            Button { text: "OUT"; accessible-label: root.deck-label + " loop out"; enabled: loaded && !loading && loop-has-in; clicked => { root.loop-out(); } }
            Button { text: loop-active ? "ACTIVE" : "LOOP"; accessible-label: root.deck-label + " activate loop"; enabled: loaded && !loading && loop-ready && !loop-active; clicked => { root.loop-activate(); } }
            Button { text: "EXIT"; accessible-label: root.deck-label + " exit loop"; enabled: loaded && !loading && loop-active; clicked => { root.loop-exit(); } }
            Button { text: root.tools-panel == 0 ? "SLOTS" : (root.tools-panel == 1 ? "AUTO" : (root.tools-panel == 2 ? "PITCH" : (root.tools-panel == 3 ? "NUDGE" : "CUES"))); width: 48px; accessible-label: root.deck-label + " deck tools panel"; clicked => { root.cancel-nudge(); root.tools-panel = root.tools-panel == 4 ? 0 : root.tools-panel + 1; } }
            Text { width: 64px; text: root.loop-caption; accessible-role: text; accessible-label: root.deck-label + " loop state"; accessible-description: root.loop-caption; color: loop-active ? #4ee79b : #a8b3c3; font-size: 10px; overflow: elide; vertical-alignment: center; }
        }
        if root.tools-panel == 1 : HorizontalLayout {
            height: 28px; spacing: 2px;
            SpinBox { width: 64px; minimum: 1; maximum: 8; value <=> root.saved-loop-slot; accessible-label: root.deck-label + " saved loop slot"; }
            LineEdit { width: 68px; text <=> root.saved-loop-name; placeholder-text: "Loop name"; accessible-label: root.deck-label + " saved loop name"; }
            Button { text: "SAVE"; accessible-label: root.deck-label + " save loop slot"; enabled: loaded && !loading && loop-ready; clicked => { root.save-loop(); } }
            Button { text: "RECALL"; accessible-label: root.deck-label + " recall loop slot"; enabled: loaded && !loading && saved-loop-slot >= 1 && saved-loop-slot <= saved-loops.length && saved-loops[saved-loop-slot - 1].occupied; clicked => { root.recall-loop(); } }
            Button { text: "DELETE"; accessible-label: root.deck-label + " delete loop slot"; enabled: loaded && !loading && saved-loop-slot >= 1 && saved-loop-slot <= saved-loops.length && saved-loops[saved-loop-slot - 1].occupied; clicked => { root.delete-loop(); } }
        }
        if root.tools-panel == 1 : Text { height: 14px; text: root.saved-loop-slot >= 1 && root.saved-loop-slot <= root.saved-loops.length ? root.saved-loops[root.saved-loop-slot - 1].description : "Empty slot"; color: #a8b3c3; font-size: 10px; overflow: elide; accessible-role: text; accessible-label: root.deck-label + " saved loop description"; }
        if root.tools-panel == 2 : HorizontalLayout {
            height: 28px; spacing: 2px;
            ComboBox { model: ["1/8 beat","1/4 beat","1/2 beat","1 beat","2 beats","4 beats","8 beats","16 beats","32 beats"]; current-index <=> root.auto-loop-index; accessible-label: root.deck-label + " auto loop length"; }
            Button { text: "AUTO LOOP"; accessible-label: root.deck-label + " auto loop"; enabled: loaded && !loading && grid-active; clicked => { root.auto-loop(); } }
            Button { text: "½"; accessible-label: root.deck-label + " half loop"; enabled: loaded && !loading && loop-ready; clicked => { root.half-loop(); } }
            Button { text: "×2"; accessible-label: root.deck-label + " double loop"; enabled: loaded && !loading && loop-ready; clicked => { root.double-loop(); } }
        }
        if root.tools-panel == 2 : HorizontalLayout {
            height: 26px; spacing: 2px;
            CheckBox { text: "BEAT SNAP"; checked <=> root.auto-loop-snap; accessible-label: root.deck-label + " auto loop beat snap"; enabled: loaded && !loading && grid-active; }
            Text { text: root.auto-loop-snap ? "Nearest beat · manual grid" : "Start at playhead"; color: #a8b3c3; font-size: 10px; vertical-alignment: center; }
        }
        if root.tools-panel == 3 : VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                height: 28px;
                ComboBox { width: 76px; model: ["±8%","±16%","±50%","Wide"]; current-index <=> root.pitch-range-index; accessible-label: root.deck-label + " pitch range"; selected => { root.pitch-range(); } }
                if !root.pitch-outside : Slider { minimum: root.pitch-min; maximum: root.pitch-max; value <=> root.pitch-percent; accessible-label: root.deck-label + " pitch"; enabled: loaded && !loading; changed(value) => { root.pitch(value); } }
                if root.pitch-outside : Text { text: "Outside range"; color: #ffcc77; font-size: 10px; vertical-alignment: center; }
                Button { width: 28px; text: "−"; accessible-label: root.deck-label + " pitch fine down"; enabled: loaded && !loading && root.pitch-can-down; clicked => { root.pitch-down(); } }
                Button { width: 28px; text: "+"; accessible-label: root.deck-label + " pitch fine up"; enabled: loaded && !loading && root.pitch-can-up; clicked => { root.pitch-up(); } }
                Text { width: 48px; text: round(root.pitch-percent*100)/100 + "%"; color: #b9c7d9; font-size: 11px; vertical-alignment: center; }
                Button { width: 40px; text: "1×"; accessible-label: root.deck-label + " reset pitch"; enabled: loaded && !loading; clicked => { root.reset-pitch(); } }
            }
            Text { height: 12px; text: root.pitch-caption; color: #b9c7d9; font-size: 10px; overflow: elide; accessible-role: text; accessible-label: root.deck-label + " pitch values"; accessible-description: root.pitch-caption; }
            Text { height: 12px; text: root.bpm-caption; color: #b9c7d9; font-size: 10px; overflow: elide; accessible-role: text; accessible-label: root.deck-label + " source and current BPM"; accessible-description: root.bpm-caption; }
        }
        if root.tools-panel == 4 : VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                height: 28px; spacing: 4px;
                NudgeHold { label: root.deck-label + " nudge down"; text: "HOLD −2%"; enabled: root.loaded && root.playing && !root.loading; held(value) => { root.nudge(-1, value); } cancel => { root.cancel-nudge(); } }
                NudgeHold { label: root.deck-label + " nudge up"; text: "HOLD +2%"; enabled: root.loaded && root.playing && !root.loading; held(value) => { root.nudge(1, value); } cancel => { root.cancel-nudge(); } }
                Button { text: "CANCEL"; accessible-label: root.deck-label + " cancel nudge"; clicked => { root.cancel-nudge(); } }
            }
            Text { height: 12px; text: root.pitch-caption; color: #b9c7d9; font-size: 10px; overflow: elide; }
            Text { height: 12px; text: root.bpm-caption; color: #b9c7d9; font-size: 10px; overflow: elide; }
        }
        if !root.cue-editing && root.tools-panel == 0 : HorizontalLayout {
            height: 26px;
            Text { text: "SLOT"; color: #a8b3c3; font-size: 10px; vertical-alignment: center; }
            SpinBox { minimum: 1; maximum: 8; value <=> root.delete-slot; accessible-label: deck-label + " delete hot cue slot"; }
            Button { text: "EDIT"; accessible-label: deck-label + " edit hot cue"; enabled: loaded && !loading; clicked => { root.edit-hot-cue(root.delete-slot - 1); } }
            Button { text: "DELETE"; accessible-label: deck-label + " delete hot cue"; enabled: loaded && !loading; clicked => { root.delete-hot-cue(root.delete-slot - 1); } }
        }
        if root.cue-editing && root.tools-panel == 0 : HorizontalLayout {
            height: 26px; spacing: 2px;
            LineEdit { text <=> root.cue-name; accessible-label: root.deck-label + " cue name"; placeholder-text: "Cue name"; }
            LineEdit { width: 74px; text <=> root.cue-rgb; accessible-label: root.deck-label + " cue RGB"; placeholder-text: "RRGGBB"; }
            Button { text: "SAVE"; accessible-label: root.deck-label + " save hot cue"; enabled: !loading; clicked => { root.save-hot-cue(); } }
            Button { text: "CANCEL"; accessible-label: root.deck-label + " cancel hot cue"; clicked => { root.cancel-hot-cue(); } }
        }
    }
}

component DetailWaveform inherits Rectangle {
    in property <string> deck-label;
    in property <brush> accent;
    in property <[float]> detail;
    in property <[color]> colors;
    in property <[BeatLine]> beats;
    in property <[HotCueRow]> hot-cues;
    in property <LoopRange> loop-range;
    in property <bool> enabled;
    in property <bool> grid-active;
    in property <bool> grid-editing;
    in property <bool> grid-controls-enabled;
    in-out property <string> grid-draft-bpm;
    callback edit-bpm(); callback anchor-grid(); callback earlier-grid(); callback later-grid(); callback save-grid(); callback cancel-grid();
    in property <string> grid-caption;
    in-out property <int> grid-bpm: 120;
    in property <int> suggested-bpm;
    in property <float> position;
    in property <float> detail-start;
    in property <float> detail-end: 100;
    in property <float> marker;
    in-out property <int> detail-window: 8;
    callback seek(float); callback zoom(); callback set-grid(); callback clear-grid();
    background: #10151d;
    VerticalLayout {
        padding: 3px; spacing: 2px;
        if !root.grid-editing : HorizontalLayout {
            spacing: 4px;
            Text { text: deck-label; color: accent; width: 62px; font-size: 12px; vertical-alignment: center; }
            Text { text: "≤ " + detail-window + " s"; color: #abb6c6; width: 44px; font-size: 11px; vertical-alignment: center; }
            Button { text: "+"; width: 32px; accessible-label: deck-label + " zoom in"; enabled: root.enabled && detail-window > 2; clicked => { detail-window = max(2, detail-window / 2); root.zoom(); } }
            Button { text: "−"; width: 32px; accessible-label: deck-label + " zoom out"; enabled: root.enabled && detail-window < 32; clicked => { detail-window = min(32, detail-window * 2); root.zoom(); } }
            Button { text: suggested-bpm > 0 ? "USE ~" + suggested-bpm : "NO EST."; width: 80px; accessible-label: deck-label + " use BPM suggestion"; enabled: root.grid-controls-enabled && !root.grid-active && suggested-bpm > 0; clicked => { grid-bpm = suggested-bpm; } }
            SpinBox { minimum: 40; maximum: 240; width: 70px; value <=> grid-bpm; enabled: root.grid-controls-enabled && !root.grid-active; accessible-label: deck-label + " manual BPM"; accessible-description: "Initial BPM for a new grid. Use Edit Grid for an existing grid."; }
            Button { text: "EDIT GRID"; width: 88px; accessible-label: deck-label + " edit beatgrid"; enabled: root.grid-controls-enabled; clicked => { root.set-grid(); } }
            Button { text: "GRID OFF"; width: 80px; accessible-label: deck-label + " clear beatgrid"; enabled: root.grid-controls-enabled && grid-active; clicked => { root.clear-grid(); } }
            Text { text: grid-caption; color: #a0adbe; font-size: 11px; overflow: elide; vertical-alignment: center; }
        }
        if root.grid-editing : HorizontalLayout {
            spacing: 3px;
            Text { text: root.deck-label + " GRID"; color: root.accent; width: 78px; font-size: 11px; vertical-alignment: center; }
            Button { text: "+"; width: 28px; accessible-label: root.deck-label + " zoom in"; enabled: root.enabled && root.detail-window > 2; clicked => { root.detail-window = max(2,root.detail-window/2); root.zoom(); } }
            Button { text: "−"; width: 28px; accessible-label: root.deck-label + " zoom out"; enabled: root.enabled && root.detail-window < 32; clicked => { root.detail-window = min(32,root.detail-window*2); root.zoom(); } }
            LineEdit { width: 76px; text <=> root.grid-draft-bpm; accessible-label: root.deck-label + " draft BPM"; enabled: root.grid-controls-enabled; edited => { root.edit-bpm(); } accepted => { root.save-grid(); } }
            Button { text: "USE ~"; width: 58px; accessible-label: root.deck-label + " use draft BPM suggestion"; enabled: root.grid-controls-enabled && root.suggested-bpm > 0; clicked => { root.grid-draft-bpm = "" + root.suggested-bpm; root.edit-bpm(); } }
            Button { text: "SET 1"; width: 56px; accessible-label: root.deck-label + " anchor draft at playhead"; enabled: root.grid-controls-enabled; clicked => { root.anchor-grid(); } }
            Button { text: "−10ms"; width: 60px; accessible-label: root.deck-label + " shift grid earlier"; enabled: root.grid-controls-enabled; clicked => { root.earlier-grid(); } }
            Button { text: "+10ms"; width: 60px; accessible-label: root.deck-label + " shift grid later"; enabled: root.grid-controls-enabled; clicked => { root.later-grid(); } }
            Button { text: "CLEAR"; width: 60px; accessible-label: root.deck-label + " clear draft grid"; enabled: root.grid-controls-enabled; clicked => { root.clear-grid(); } }
            Button { text: "SAVE"; width: 55px; accessible-label: root.deck-label + " save beatgrid"; enabled: root.grid-controls-enabled; clicked => { root.save-grid(); } }
            Button { text: "CANCEL"; width: 66px; accessible-label: root.deck-label + " cancel beatgrid"; clicked => { root.cancel-grid(); } }
            Text { text: root.grid-caption; color: #ffce77; font-size: 11px; overflow: elide; vertical-alignment: center; }
        }
        WaveformStrip {
            height: 54px; overview: false; deck-label: root.deck-label; accent: root.accent;
            values: root.detail; colors: root.colors; hot-cues: root.hot-cues; loop-range: root.loop-range; beats: root.beats; enabled: root.enabled;
            position: root.position; marker: root.marker; range-start: root.detail-start; range-end: root.detail-end;
            seek(value) => { root.seek(value); }
        }
    }
}

component CratePanel inherits Rectangle {
    in property <[CrateRow]> rows;
    in property <[string]> names;
    in property <int> selection;
    in property <bool> busy;
    in property <bool> has-track;
    in property <bool> editor-open;
    in property <bool> delete-pending;
    in property <string> dialog-title;
    in-out property <string> edit-name;
    in-out property <int> target-index;
    callback select-crate(int); callback target-changed(int);
    callback new-crate(); callback rename-crate(); callback delete-crate();
    callback save-name(); callback cancel-dialog(); callback confirm-delete();
    callback add-track(); callback remove-track();
    background: #121821; border-color: #303b4b; border-width: 1px;
    VerticalLayout {
        padding: 5px; spacing: 3px;
        Button { text: "ALL TRACKS"; accessible-label: "All library tracks"; enabled: !busy; clicked => { root.select-crate(0); } }
        ListView {
            for entry in root.rows : Rectangle {
                height: 28px; background: root.selection == entry.id ? #194b70 : #1a222e;
                accessible-role: button; accessible-label: "Crate " + entry.id;
                accessible-description: entry.name + " (" + entry.count + " tracks)";
                accessible-action-default => { if !root.busy { root.select-crate(entry.id); } }
                HorizontalLayout { padding: 4px;
                    Text { text: entry.name; color: #e4ebf6; overflow: elide; }
                    Text { text: "" + entry.count; color: #9faec2; horizontal-alignment: right; }
                }
                TouchArea { enabled: !root.busy; clicked => { root.select-crate(entry.id); } }
            }
        }
        Button { text: "NEW CRATE"; accessible-label: "New crate"; enabled: !busy; clicked => { root.new-crate(); } }
        HorizontalLayout {
            Button { text: "RENAME"; accessible-label: "Rename crate"; enabled: !busy && selection > 0; clicked => { root.rename-crate(); } }
            Button { text: "DELETE"; accessible-label: "Delete crate"; enabled: !busy && selection > 0; clicked => { root.delete-crate(); } }
        }
        ComboBox { model: root.names; current-index <=> root.target-index; accessible-label: "Target crate"; enabled: !busy && root.names.length > 0; selected(value) => { root.target-changed(self.current-index); } }
        HorizontalLayout {
            Button { text: "ADD"; accessible-label: "Add selected track to crate"; enabled: !busy && has-track && names.length > 0; clicked => { root.add-track(); } }
            Button { text: "REMOVE"; accessible-label: "Remove selected track from crate"; enabled: !busy && has-track && selection > 0; clicked => { root.remove-track(); } }
        }
    }
    if editor-open || delete-pending : Rectangle {
        background: #182331;
        VerticalLayout { padding: 8px; spacing: 6px;
            Text { text: root.dialog-title; color: #e4ebf6; wrap: word-wrap; }
            if root.editor-open : LineEdit { text <=> root.edit-name; accessible-label: "Crate name"; enabled: !root.busy; accepted => { root.save-name(); } }
            if root.delete-pending : Text { text: "Only this crate and its memberships are removed. Audio files stay in the library."; color: #a5b5ca; wrap: word-wrap; }
            if root.editor-open : Button { text: "SAVE"; accessible-label: "Save crate name"; enabled: !root.busy; clicked => { root.save-name(); } }
            if root.delete-pending : Button { text: "CONFIRM DELETE"; accessible-label: "Confirm crate deletion"; enabled: !root.busy; clicked => { root.confirm-delete(); } }
            Button { text: "CANCEL"; accessible-label: "Cancel crate dialog"; clicked => { root.cancel-dialog(); } }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

component TrackLibrary inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <string> count-text;
    in property <string> empty-text;
    in property <string> storage-text;
    in property <bool> save-failed;
    in property <bool> busy;
    in property <bool> can-load-left;
    in property <bool> can-load-right;
    in property <int> selection: -1;
    in-out property <string> query;
    callback import-files(); callback search(); callback select-track(int); callback move-selection(int);
    callback sort-column(int); callback load-left(); callback load-right();
    callback retry-save();
    background: #121821; border-color: #303b4b; border-width: 1px;
    VerticalLayout {
        padding: 6px; spacing: 4px;
        HorizontalLayout {
            Text { text: "LOCAL LIBRARY"; color: #e4ebf6; font-weight: 700; vertical-alignment: center; }
            Button { text: busy ? "WORKING…" : "ADD FILES"; enabled: !busy; accessible-label: "Import library files"; clicked => { root.import-files(); } }
            LineEdit { text <=> query; placeholder-text: "Search title, artist, album or path"; accessible-label: "Library search"; edited => { root.search(); } }
            Button { text: "X"; width: 30px; accessible-label: "Clear library search"; enabled: query != ""; clicked => { query = ""; root.search(); } }
            Button { text: "LOAD A"; accessible-label: "Load selected into deck A"; enabled: can-load-left; clicked => { root.load-left(); } }
            Button { text: "LOAD B"; accessible-label: "Load selected into deck B"; enabled: can-load-right; clicked => { root.load-right(); } }
        }
        HorizontalLayout {
            Button { text: "TITLE ↕"; horizontal-stretch: 2; accessible-label: "Sort library by name"; clicked => { root.sort-column(0); } }
            Button { text: "ARTIST ↕"; horizontal-stretch: 1; accessible-label: "Sort library by artist"; clicked => { root.sort-column(3); } }
            Button { text: "ALBUM ↕"; horizontal-stretch: 1; accessible-label: "Sort library by album"; clicked => { root.sort-column(4); } }
            Button { text: "TIME ↕"; width: 70px; accessible-label: "Sort library by duration"; clicked => { root.sort-column(5); } }
            Button { text: "TYPE ↕"; width: 70px; accessible-label: "Sort library by type"; clicked => { root.sort-column(1); } }
            Button { text: "LOCATION ↕"; horizontal-stretch: 2; accessible-label: "Sort library by path"; clicked => { root.sort-column(2); } }
        }
        nav := FocusScope {
            key-pressed(event) => {
                if event.text == Key.DownArrow { root.move-selection(1); return accept; }
                if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
                return reject;
            }
            ListView {
                for row in root.rows : Rectangle {
                    height: 30px; background: root.selection == row.id ? #194b70 : #1a222e;
                    accessible-role: button; accessible-label: "Library track " + row.id;
                    accessible-description: (row.available ? "" : "Missing file: ") + row.name + " " + row.artist + " " + row.album + " " + row.duration + " " + row.path + (row.metadata-error == "" ? "" : " Metadata unavailable: " + row.metadata-error);
                    accessible-action-default => { root.select-track(row.id); nav.focus(); }
                    HorizontalLayout {
                        padding-left: 6px;
                        Text { text: row.name; color: #e4ebf6; overflow: elide; horizontal-stretch: 2; }
                        Text { text: row.artist == "" ? "—" : row.artist; color: #9faec2; overflow: elide; horizontal-stretch: 1; }
                        Text { text: row.album == "" ? "—" : row.album; color: #9faec2; overflow: elide; horizontal-stretch: 1; }
                        Text { text: row.duration; color: #9faec2; width: 70px; }
                        Text { text: row.available ? (row.metadata-error == "" ? row.format : row.format + " ?") : "MISSING"; color: row.available ? #9faec2 : #ffae58; width: 70px; }
                        Text { text: row.path; color: #9faec2; overflow: elide; horizontal-stretch: 2; }
                    }
                    TouchArea { clicked => { root.select-track(row.id); nav.focus(); } }
                }
            }
            Text { text: empty-text; visible: rows.length == 0; color: #9faec2; horizontal-alignment: center; vertical-alignment: center; }
        }
        HorizontalLayout {
            Text { text: count-text; color: #9faec2; font-size: 11px; vertical-alignment: center; }
            Text { text: storage-text; accessible-role: text; accessible-label: "Library storage status"; color: save-failed ? #ffae58 : #9faec2; font-size: 11px; overflow: elide; vertical-alignment: center; }
            if save-failed : Button { text: "RETRY SAVE"; accessible-label: "Retry library save"; clicked => { root.retry-save(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "DrDJ Pro"; preferred-width: 1280px; preferred-height: 860px;
    min-width: 850px; min-height: 740px; background: #090d13;
    in property <[float]> left-waveform;
    in property <[float]> right-waveform;
    in property <[float]> left-detail;
    in property <[float]> right-detail;
    in property <[color]> left-waveform-colors;
    in property <[color]> right-waveform-colors;
    in property <[color]> left-detail-colors;
    in property <[color]> right-detail-colors;
    in property <[BeatLine]> left-beats;
    in property <[BeatLine]> right-beats;
    in property <bool> left-grid-active;
    in property <bool> right-grid-active;
    in property <string> left-grid-caption: "GRID OFF";
    in property <string> right-grid-caption: "GRID OFF";
    in-out property <int> left-grid-bpm: 120;
    in-out property <int> right-grid-bpm: 120;
    in property <int> left-suggested-bpm: 0;
    in property <int> right-suggested-bpm: 0;
    in property <float> left-detail-start;
    in property <float> left-detail-end: 100;
    in property <float> left-detail-marker;
    in property <float> right-detail-start;
    in property <float> right-detail-end: 100;
    in property <float> right-detail-marker;
    in-out property <int> left-detail-window: 8;
    in-out property <int> right-detail-window: 8;
    in property <bool> audio-enabled: false;
    in property <bool> loading: false;
    in property <bool> left-busy: false;
    in property <bool> right-busy: false;
    in property <bool> left-loaded: false;
    in property <bool> right-loaded: false;
    in property <string> left-title: "DEMO TRACK";
    in property <string> right-title: "DEMO TRACK";
    in property <string> left-time: "SIMULATION";
    in property <string> right-time: "SIMULATION";
    in property <string> status;
    in-out property <float> channel-a: 1;
    in-out property <float> channel-b: 1;
    in-out property <float> crossfader: 0.5;
    in-out property <bool> left-playing: false;
    in-out property <bool> right-playing: false;
    in-out property <float> left-position: 0;
    in-out property <float> right-position: 0;
    in property <[HotCueRow]> left-hot-cues;
    in-out property <int> left-pitch-range-index: 3;
    in property <float> left-pitch-min: -50; in property <float> left-pitch-max: 100;
    in property <bool> left-pitch-outside; in property <bool> left-pitch-can-down; in property <bool> left-pitch-can-up;
    callback pitch-range-left(); callback pitch-down-left(); callback pitch-up-left();
    in-out property <float> left-pitch-percent;
    in property <string> left-pitch-caption;
    in property <string> left-bpm-caption;
    callback nudge-left(int, bool); callback cancel-nudge-left();
    callback pitch-left(float); callback reset-pitch-left();
    in-out property <bool> left-auto-loop-snap: false;
    in-out property <int> left-auto-loop-index: 5;
    callback auto-loop-left(); callback half-loop-left(); callback double-loop-left();
    in property <[SavedLoopRow]> left-saved-loops;
    in-out property <int> left-saved-loop-slot: 1;
    in-out property <string> left-saved-loop-name;
    callback save-loop-left(); callback recall-loop-left(); callback delete-loop-left();
    in property <LoopRange> left-loop-range;
    in property <LoopRange> left-detail-loop-range;
    in property <string> left-loop-caption;
    in property <bool> left-loop-has-in;
    in property <bool> left-loop-ready;
    in property <bool> left-loop-active;
    callback loop-in-left(); callback loop-out-left(); callback loop-activate-left(); callback loop-exit-left();
    in property <bool> left-cue-editing;
    in-out property <string> left-cue-name;
    in-out property <string> left-cue-rgb;
    callback edit-hot-cue-left(int); callback save-hot-cue-left(); callback cancel-hot-cue-left();
    in property <[HotCueRow]> right-hot-cues;
    in-out property <int> right-pitch-range-index: 3;
    in property <float> right-pitch-min: -50; in property <float> right-pitch-max: 100;
    in property <bool> right-pitch-outside; in property <bool> right-pitch-can-down; in property <bool> right-pitch-can-up;
    callback pitch-range-right(); callback pitch-down-right(); callback pitch-up-right();
    in-out property <float> right-pitch-percent;
    in property <string> right-pitch-caption;
    in property <string> right-bpm-caption;
    callback nudge-right(int, bool); callback cancel-nudge-right();
    callback pitch-right(float); callback reset-pitch-right();
    in-out property <bool> right-auto-loop-snap: false;
    in-out property <int> right-auto-loop-index: 5;
    callback auto-loop-right(); callback half-loop-right(); callback double-loop-right();
    in property <[SavedLoopRow]> right-saved-loops;
    in-out property <int> right-saved-loop-slot: 1;
    in-out property <string> right-saved-loop-name;
    callback save-loop-right(); callback recall-loop-right(); callback delete-loop-right();
    in property <LoopRange> right-loop-range;
    in property <LoopRange> right-detail-loop-range;
    in property <string> right-loop-caption;
    in property <bool> right-loop-has-in;
    in property <bool> right-loop-ready;
    in property <bool> right-loop-active;
    callback loop-in-right(); callback loop-out-right(); callback loop-activate-right(); callback loop-exit-right();
    in property <bool> right-cue-editing;
    in-out property <string> right-cue-name;
    in-out property <string> right-cue-rgb;
    callback edit-hot-cue-right(int); callback save-hot-cue-right(); callback cancel-hot-cue-right();
    callback hot-cue-left(int); callback hot-cue-right(int);
    callback delete-hot-cue-left(int); callback delete-hot-cue-right(int);
    callback toggle-left();
    callback toggle-right();
    callback reset-left();
    callback reset-right();
    callback load-left();
    callback load-right();
    callback mixer-changed();
    callback seek-left(float);
    callback seek-right(float);
    callback zoom-left();
    callback zoom-right();
    in property <bool> left-grid-editing;
    in property <bool> right-grid-editing;
    in-out property <string> left-grid-draft-bpm;
    in-out property <string> right-grid-draft-bpm;
    callback edit-grid-bpm-left(); callback edit-grid-bpm-right();
    callback grid-anchor-left(); callback grid-anchor-right();
    callback grid-earlier-left(); callback grid-earlier-right();
    callback grid-later-left(); callback grid-later-right();
    callback save-grid-left(); callback save-grid-right();
    callback cancel-grid-left(); callback cancel-grid-right();
    callback grid-left();
    callback grid-right();
    callback clear-grid-left();
    callback clear-grid-right();

    in property <[LibraryRow]> library-rows;
    in property <string> library-count: "0 tracks";
    in property <string> library-storage: "Session library";
    in property <bool> library-save-failed;
    callback retry-library-save();
    in property <string> library-empty: "Add MP3/WAV files to your library";
    in property <bool> library-busy: false;
    in property <int> selected-track: -1;
    in-out property <string> library-query;
    callback import-library(); callback library-search(); callback select-library(int);
    callback move-library-selection(int); callback sort-library(int);
    callback load-library-left(); callback load-library-right();
    in property <[CrateRow]> crate-rows;
    in property <[string]> crate-names;
    in property <int> selected-crate;
    in-out property <int> target-crate-index;
    in property <bool> crate-editor-open;
    in property <bool> crate-delete-pending;
    in property <string> crate-dialog-title;
    in-out property <string> crate-edit-name;
    callback select-crate(int); callback target-crate(int);
    callback new-crate(); callback rename-crate(); callback delete-crate();
    callback save-crate-name(); callback confirm-delete-crate(); callback cancel-crate-dialog();
    callback add-to-crate(); callback remove-from-crate();
    VerticalLayout {
        padding: 8px; spacing: 6px;
        HorizontalLayout {
            height: 32px;
            Text { text: "DRDJ PRO"; color: #f1f4fa; font-size: 21px; font-weight: 800; vertical-alignment: center; }
            Text { text: "EXTENDED / " + (audio-enabled ? "INTERNAL AUDIO" : "SIMULATION · NO AUDIO"); color: #9cacc1; horizontal-alignment: right; vertical-alignment: center; }
        }
        HorizontalLayout {
            height: 260px; spacing: 8px;
            CompactDeck {
                deck-label: "DECK A"; accent: #36c9ef; track-title: root.left-title; time-text: root.left-time;
                waveform: root.left-waveform; colors: root.left-waveform-colors;
                pitch-range-index <=> root.left-pitch-range-index; pitch-min: root.left-pitch-min; pitch-max: root.left-pitch-max; pitch-outside: root.left-pitch-outside; pitch-can-down: root.left-pitch-can-down; pitch-can-up: root.left-pitch-can-up;
                pitch-range => { root.pitch-range-left(); } pitch-down => { root.pitch-down-left(); } pitch-up => { root.pitch-up-left(); }
                pitch-percent <=> root.left-pitch-percent; pitch-caption: root.left-pitch-caption; bpm-caption: root.left-bpm-caption;
                nudge(direction, held) => { root.nudge-left(direction, held); } cancel-nudge => { root.cancel-nudge-left(); }
                pitch(value) => { root.pitch-left(value); } reset-pitch => { root.reset-pitch-left(); }
                grid-active: root.left-grid-active; auto-loop-index <=> root.left-auto-loop-index; auto-loop-snap <=> root.left-auto-loop-snap;
                auto-loop => { root.auto-loop-left(); } half-loop => { root.half-loop-left(); } double-loop => { root.double-loop-left(); }
                saved-loops: root.left-saved-loops; saved-loop-slot <=> root.left-saved-loop-slot; saved-loop-name <=> root.left-saved-loop-name;
                save-loop => { root.save-loop-left(); } recall-loop => { root.recall-loop-left(); } delete-loop => { root.delete-loop-left(); }
                loop-range: root.left-loop-range;
                loop-caption: root.left-loop-caption; loop-has-in: root.left-loop-has-in; loop-ready: root.left-loop-ready; loop-active: root.left-loop-active;
                loop-in => { root.loop-in-left(); } loop-out => { root.loop-out-left(); } loop-activate => { root.loop-activate-left(); } loop-exit => { root.loop-exit-left(); }
                hot-cues: root.left-hot-cues;
                cue-editing: root.left-cue-editing; cue-name <=> root.left-cue-name; cue-rgb <=> root.left-cue-rgb;
                edit-hot-cue(slot) => { root.edit-hot-cue-left(slot); }
                save-hot-cue => { root.save-hot-cue-left(); } cancel-hot-cue => { root.cancel-hot-cue-left(); }
                hot-cue(slot) => { root.hot-cue-left(slot); }
                delete-hot-cue(slot) => { root.delete-hot-cue-left(slot); }
                playing: root.left-playing; position <=> root.left-position;
                audio-enabled: root.audio-enabled; loaded: root.left-loaded; loading: root.left-busy; load-busy: root.loading || root.library-busy;
                load => { root.load-left(); } toggle => { root.toggle-left(); } cue => { root.reset-left(); } seek(value) => { root.seek-left(value); }
            }
            CompactDeck {
                deck-label: "DECK B"; accent: #ffae58; track-title: root.right-title; time-text: root.right-time;
                waveform: root.right-waveform; colors: root.right-waveform-colors;
                pitch-range-index <=> root.right-pitch-range-index; pitch-min: root.right-pitch-min; pitch-max: root.right-pitch-max; pitch-outside: root.right-pitch-outside; pitch-can-down: root.right-pitch-can-down; pitch-can-up: root.right-pitch-can-up;
                pitch-range => { root.pitch-range-right(); } pitch-down => { root.pitch-down-right(); } pitch-up => { root.pitch-up-right(); }
                pitch-percent <=> root.right-pitch-percent; pitch-caption: root.right-pitch-caption; bpm-caption: root.right-bpm-caption;
                nudge(direction, held) => { root.nudge-right(direction, held); } cancel-nudge => { root.cancel-nudge-right(); }
                pitch(value) => { root.pitch-right(value); } reset-pitch => { root.reset-pitch-right(); }
                grid-active: root.right-grid-active; auto-loop-index <=> root.right-auto-loop-index; auto-loop-snap <=> root.right-auto-loop-snap;
                auto-loop => { root.auto-loop-right(); } half-loop => { root.half-loop-right(); } double-loop => { root.double-loop-right(); }
                saved-loops: root.right-saved-loops; saved-loop-slot <=> root.right-saved-loop-slot; saved-loop-name <=> root.right-saved-loop-name;
                save-loop => { root.save-loop-right(); } recall-loop => { root.recall-loop-right(); } delete-loop => { root.delete-loop-right(); }
                loop-range: root.right-loop-range;
                loop-caption: root.right-loop-caption; loop-has-in: root.right-loop-has-in; loop-ready: root.right-loop-ready; loop-active: root.right-loop-active;
                loop-in => { root.loop-in-right(); } loop-out => { root.loop-out-right(); } loop-activate => { root.loop-activate-right(); } loop-exit => { root.loop-exit-right(); }
                hot-cues: root.right-hot-cues;
                cue-editing: root.right-cue-editing; cue-name <=> root.right-cue-name; cue-rgb <=> root.right-cue-rgb;
                edit-hot-cue(slot) => { root.edit-hot-cue-right(slot); }
                save-hot-cue => { root.save-hot-cue-right(); } cancel-hot-cue => { root.cancel-hot-cue-right(); }
                hot-cue(slot) => { root.hot-cue-right(slot); }
                delete-hot-cue(slot) => { root.delete-hot-cue-right(slot); }
                playing: root.right-playing; position <=> root.right-position;
                audio-enabled: root.audio-enabled; loaded: root.right-loaded; loading: root.right-busy; load-busy: root.loading || root.library-busy;
                load => { root.load-right(); } toggle => { root.toggle-right(); } cue => { root.reset-right(); } seek(value) => { root.seek-right(value); }
            }
        }
        Rectangle {
            height: 36px; background: #171d27;
            HorizontalLayout {
                padding: 4px; spacing: 8px;
                Text { text: "A"; color: #36c9ef; vertical-alignment: center; }
                Slider { accessible-label: "Channel A fader"; minimum: 0; maximum: 1; value <=> root.channel-a; changed => { root.mixer-changed(); } }
                Text { text: "CROSSFADER"; color: #a6b4c8; font-size: 11px; vertical-alignment: center; }
                Slider { accessible-label: "Crossfader"; minimum: 0; maximum: 1; value <=> root.crossfader; changed => { root.mixer-changed(); } }
                Text { text: "B"; color: #ffae58; vertical-alignment: center; }
                Slider { accessible-label: "Channel B fader"; minimum: 0; maximum: 1; value <=> root.channel-b; changed => { root.mixer-changed(); } }
            }
        }
        Rectangle {
            accessible-role: groupbox; accessible-label: "Shared waveform area";
            height: 184px; background: #10151d;
            VerticalLayout { spacing: 2px;
                DetailWaveform {
                    deck-label: "DECK A"; accent: #36c9ef; detail: root.left-detail; colors: root.left-detail-colors;
                    loop-range: root.left-detail-loop-range;
                    hot-cues: root.left-hot-cues; beats: root.left-beats; position: root.left-position; marker: root.left-detail-marker;
                    detail-start: root.left-detail-start; detail-end: root.left-detail-end;
                    detail-window <=> root.left-detail-window; grid-bpm <=> root.left-grid-bpm;
                    grid-active: root.left-grid-active; grid-caption: root.left-grid-caption;
                    grid-editing: root.left-grid-editing; grid-draft-bpm <=> root.left-grid-draft-bpm;
                    grid-controls-enabled: root.audio-enabled && root.left-loaded && !root.left-busy;
                    edit-bpm => { root.edit-grid-bpm-left(); } anchor-grid => { root.grid-anchor-left(); }
                    earlier-grid => { root.grid-earlier-left(); } later-grid => { root.grid-later-left(); }
                    save-grid => { root.save-grid-left(); } cancel-grid => { root.cancel-grid-left(); }
                    suggested-bpm: root.left-suggested-bpm; enabled: root.audio-enabled && root.left-loaded;
                    seek(value) => { root.seek-left(value); } zoom => { root.zoom-left(); }
                    set-grid => { root.grid-left(); } clear-grid => { root.clear-grid-left(); }
                }
                DetailWaveform {
                    deck-label: "DECK B"; accent: #ffae58; detail: root.right-detail; colors: root.right-detail-colors;
                    loop-range: root.right-detail-loop-range;
                    hot-cues: root.right-hot-cues; beats: root.right-beats; position: root.right-position; marker: root.right-detail-marker;
                    detail-start: root.right-detail-start; detail-end: root.right-detail-end;
                    detail-window <=> root.right-detail-window; grid-bpm <=> root.right-grid-bpm;
                    grid-active: root.right-grid-active; grid-caption: root.right-grid-caption;
                    grid-editing: root.right-grid-editing; grid-draft-bpm <=> root.right-grid-draft-bpm;
                    grid-controls-enabled: root.audio-enabled && root.right-loaded && !root.right-busy;
                    edit-bpm => { root.edit-grid-bpm-right(); } anchor-grid => { root.grid-anchor-right(); }
                    earlier-grid => { root.grid-earlier-right(); } later-grid => { root.grid-later-right(); }
                    save-grid => { root.save-grid-right(); } cancel-grid => { root.cancel-grid-right(); }
                    suggested-bpm: root.right-suggested-bpm; enabled: root.audio-enabled && root.right-loaded;
                    seek(value) => { root.seek-right(value); } zoom => { root.zoom-right(); }
                    set-grid => { root.grid-right(); } clear-grid => { root.clear-grid-right(); }
                }
            }
        }
        Rectangle {
            accessible-role: groupbox; accessible-label: "Track library area"; vertical-stretch: 1; min-height: 160px;
            HorizontalLayout { spacing: 6px;
                CratePanel {
                    accessible-role: groupbox; accessible-label: "Crate navigation"; width: 190px;
                    rows: root.crate-rows; names: root.crate-names; selection: root.selected-crate;
                    busy: root.loading || root.library-busy || !root.audio-enabled;
                    has-track: root.selected-track >= 0; target-index <=> root.target-crate-index;
                    editor-open: root.crate-editor-open; delete-pending: root.crate-delete-pending;
                    dialog-title: root.crate-dialog-title; edit-name <=> root.crate-edit-name;
                    select-crate(id) => { root.select-crate(id); } target-changed(index) => { root.target-crate(index); }
                    new-crate => { root.new-crate(); } rename-crate => { root.rename-crate(); } delete-crate => { root.delete-crate(); }
                    save-name => { root.save-crate-name(); } cancel-dialog => { root.cancel-crate-dialog(); } confirm-delete => { root.confirm-delete-crate(); }
                    add-track => { root.add-to-crate(); } remove-track => { root.remove-from-crate(); }
                }
        TrackLibrary {
            horizontal-stretch: 1; min-width: 0px;
            rows: root.library-rows; count-text: root.library-count; empty-text: root.library-empty;
            storage-text: root.library-storage; save-failed: root.library-save-failed;
            selection: root.selected-track; query <=> root.library-query;
            busy: root.loading || root.library-busy || !root.audio-enabled;
            can-load-left: root.audio-enabled && root.selected-track >= 0 && !root.loading && !root.library-busy && !root.left-playing;
            can-load-right: root.audio-enabled && root.selected-track >= 0 && !root.loading && !root.library-busy && !root.right-playing;
            import-files => { root.import-library(); } search => { root.library-search(); }
            select-track(id) => { root.select-library(id); } move-selection(delta) => { root.move-library-selection(delta); }
            sort-column(field) => { root.sort-library(field); }
            load-left => { root.load-library-left(); } load-right => { root.load-library-right(); }
            retry-save => { root.retry-library-save(); }
        }
            }
        }
        Text { height: 22px; accessible-role: text; accessible-label: "Application status"; text: root.status; color: #a5b5ca; font-size: 12px; overflow: elide; vertical-alignment: center; }
    }
}
